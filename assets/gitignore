# .gitignore — copied verbatim from the sage-theme-builder skill (assets/gitignore).

# ---- environment -----------------------------------------------------------------------------
# Deploy config lives OUTSIDE the repository, in ~/.config/<project-slug>/ — nothing to ignore here
# except a legacy .env, kept ignored as a safety net until `bin/deploy migrate-env` removes it.
# bin/deploy.conf.example and bin/deploy.local.conf.example hold fictitious values: ALWAYS tracked.
.env
.env.*

# ---- dependencies and build output (rebuilt by every deploy) ----------------------------------
node_modules/
vendor/
wp-content/themes/*/public/build/
wp-content/themes/*/public/blocks/

# ---- deploy tooling ----------------------------------------------------------------------------
# Built release only. Backups, dumps and logs live in ~/.config/<project-slug>/, never here.
.deploy-build/

# ---- WordPress: uploads and core (if the repository is the site root) --------------------------
wp-content/uploads/
/wp-admin/
/wp-includes/
/wp-*.php
/index.php
/license.txt
/readme.html
/xmlrpc.php
wp-config.php

# ---- OS / editors -------------------------------------------------------------------------------
.DS_Store
