# .env.example — every key the project uses, each with a FICTITIOUS value.
# Committed to git. Copy to .env (gitignored, chmod 600) and replace the values.
#
# Convention: a value containing "example" or "CHANGE_ME" is a placeholder. bin/deploy treats it as
# not configured and refuses to use it, so an unfilled environment can never be deployed by mistake.
# Secrets (passwords) stay CHANGE_ME here and are filled in .env by hand — never pasted into a chat.
# Remote access (ssh and sftp) is ALWAYS by SSH key — there is no remote password in this file.
# <ENV>_SSH_KEY=default uses the keys already on this computer (ssh-agent, ~/.ssh/config, ~/.ssh/id_*).
# `bin/deploy check-env` lists which keys are still placeholders.

# ---- project -------------------------------------------------------------------------------
PROJECT_SLUG=example-project                 # lowercase slug: logs, backups, production confirmation
THEME_DIR=wp-content/themes/example-theme    # theme folder, relative to the repository root
MU_PLUGINS_DIR=wp-content/mu-plugins         # mu-plugins folder, relative to the repository root

# ---- backups ---------------------------------------------------------------------------------
BACKUP_KEEP=10                               # local backups kept per environment in .deploy-backups/ (oldest pruned)

# ---- local ---------------------------------------------------------------------------------
LOCAL_URL=https://example-project.test       # local site URL
LOCAL_WP_PATH=.                              # where wp-cli finds wp-config.php (repo-relative)
LOCAL_WP_CMD="wp"                            # how wp-cli runs locally: "wp", "ddev wp", "docker exec -i web wp"
LOCAL_COMPOSER_CMD="composer"                # how composer runs for the deploy build; in a container -w must be
                                             # the repo root: "docker exec -w /path/to/repo php-container composer"
LOCAL_DB_NAME=example_db                     # local database name
LOCAL_DB_USER=example_user                   # local database user
LOCAL_DB_PASSWORD=CHANGE_ME                  # local database password (fill by hand)
LOCAL_DB_HOST=localhost                      # local database host

# ---- staging -------------------------------------------------------------------------------
STAGING_URL=https://staging.example.com      # public staging URL
STAGING_TRANSPORT=ssh                        # ssh (rsync + remote wp-cli) | sftp (hosting without shell)
STAGING_HOST=ssh.staging.example.com         # SSH/SFTP host name, or a Host alias from ~/.ssh/config
STAGING_PORT=22                              # SSH/SFTP port
STAGING_USER=example_staging_user            # SSH/SFTP user
STAGING_SSH_KEY=default                      # "default" = keys on this computer; or a path, e.g. ~/.ssh/id_ed25519
STAGING_ROOT=/var/www/example-project/staging         # absolute path of the dir containing wp-config.php

# ---- production ----------------------------------------------------------------------------
PRODUCTION_URL=https://www.example.com       # public production URL
PRODUCTION_TRANSPORT=ssh                     # ssh | sftp
PRODUCTION_HOST=ssh.example.com              # SSH/SFTP host name, or a Host alias from ~/.ssh/config
PRODUCTION_PORT=22                           # SSH/SFTP port
PRODUCTION_USER=example_production_user      # SSH/SFTP user
PRODUCTION_SSH_KEY=default                   # "default" = keys on this computer; or a path, e.g. ~/.ssh/id_ed25519
PRODUCTION_ROOT=/var/www/example-project/production   # absolute path of the dir containing wp-config.php
