# Copy to .env (gitignored, chmod 600). Secrets: fill by hand, never paste them into a chat.
# ---- project ----------------------------------------------------------
PROJECT_SLUG=acme                       # lowercase, used for log/backup names and confirmations
THEME_DIR=wp-content/themes/acme        # relative to the repository root
MU_PLUGINS_DIR=wp-content/mu-plugins

# ---- local ------------------------------------------------------------
LOCAL_URL=https://acme.test
LOCAL_WP_PATH=.                          # where `wp` finds wp-config.php
LOCAL_WP_CMD="wp"                        # e.g. "ddev wp", "docker exec -i web wp"
LOCAL_DB_NAME=acme
LOCAL_DB_USER=acme
LOCAL_DB_PASSWORD=CHANGE_ME
LOCAL_DB_HOST=localhost

# ---- staging ----------------------------------------------------------
STAGING_URL=https://staging.acme.example
STAGING_TRANSPORT=ssh                    # ssh | sftp
STAGING_HOST=
STAGING_PORT=22
STAGING_USER=
STAGING_SSH_KEY=~/.ssh/acme_deploy       # dedicated key; also used by sftp when set
STAGING_SFTP_PASSWORD=                   # only for sftp without a key: CHANGE_ME
STAGING_ROOT=/absolute/path/to/wordpress # the directory that contains wp-config.php

# ---- production -------------------------------------------------------
PRODUCTION_URL=https://www.acme.example
PRODUCTION_TRANSPORT=ssh
PRODUCTION_HOST=
PRODUCTION_PORT=22
PRODUCTION_USER=
PRODUCTION_SSH_KEY=~/.ssh/acme_deploy_prod
PRODUCTION_SFTP_PASSWORD=
PRODUCTION_ROOT=/absolute/path/to/wordpress
