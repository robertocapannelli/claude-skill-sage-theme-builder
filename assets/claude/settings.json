{
  "permissions": {
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(git reset --hard:*)",
      "Bash(bin/deploy production:*)",
      "Bash(./bin/deploy production:*)",
      "Bash(bin/deploy staging bootstrap:*)",
      "Bash(./bin/deploy staging bootstrap:*)",
      "Bash(bin/deploy staging restore:*)",
      "Bash(./bin/deploy staging restore:*)",
      "Bash(bin/deploy clone-from-prod:*)",
      "Bash(./bin/deploy clone-from-prod:*)",
      "Bash(bin/deploy migrate-env:*)",
      "Bash(./bin/deploy migrate-env:*)"
    ],
    "deny": [
      "Read(~/.config/example-project/**)",
      "Edit(~/.config/example-project/**)",
      "Write(~/.config/example-project/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)",
      "Bash(lftp:*)",
      "Bash(sshpass:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deploy-guard.sh" }]
      }
    ]
  }
}
