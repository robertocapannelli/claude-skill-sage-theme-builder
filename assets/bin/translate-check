#!/usr/bin/env bash
# bin/translate-check — fail if any translation catalog has untranslated, fuzzy or invalid entries,
# or if a catalog the site's MAIN language needs is missing.
#
# The main language comes from, in order:
#   1. --main-locale=<locale>  or  MAIN_LOCALE=<locale>   (e.g. it_IT; en_US = English)
#   2. `wp option get WPLANG` when WP-CLI is available (empty = en_US)
# English as main language needs no catalog (the source is the text). When the main language cannot
# be determined the check still validates every catalog that exists and says so.
#
# Needs GNU gettext (msgfmt): brew install gettext. Run from anywhere; paths are repo-relative.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1
command -v msgfmt >/dev/null || { echo "translate-check: msgfmt not found (brew install gettext)" >&2; exit 1; }

main="${MAIN_LOCALE:-}"
for arg in "$@"; do
    case "$arg" in --main-locale=*) main="${arg#*=}" ;; *) echo "usage: bin/translate-check [--main-locale=<locale>]" >&2; exit 2 ;; esac
done
if [[ -z "$main" ]] && command -v wp >/dev/null; then
    if main="$(wp option get WPLANG 2>/dev/null)"; then main="${main:-en_US}"; else main=""; fi
fi

shopt -s nullglob
status=0

case "$main" in
    "")
        echo "! main language unknown (set MAIN_LOCALE or pass --main-locale): checking existing catalogs only" ;;
    en|en_*)
        echo "main language: $main — no catalog required" ;;
    *)
        echo "main language: $main"
        for pot in wp-content/themes/*/resources/lang/*.pot; do
            [[ -e "$(dirname "$pot")/$main.po" ]] || { echo "✗ missing catalog $(dirname "$pot")/$main.po" >&2; status=1; }
        done
        for pot in wp-content/mu-plugins/*/lang/*.pot; do
            po="$(dirname "$pot")/$(basename "$pot" .pot)-$main.po"
            [[ -e "$po" ]] || { echo "✗ missing catalog $po" >&2; status=1; }
        done ;;
esac

for f in wp-content/themes/*/resources/lang/*.po wp-content/mu-plugins/*/lang/*.po; do
    stats="$(LC_ALL=C msgfmt --statistics -o /dev/null "$f" 2>&1)"
    if [[ "$stats" == *untranslated* || "$stats" == *fuzzy* || "$stats" == *error* ]]; then
        echo "✗ $f — $stats"; status=1
    else
        echo "✓ $f — $stats"
    fi
done
exit $status
