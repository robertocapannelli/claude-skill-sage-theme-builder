#!/usr/bin/env bash
#
# bin/deploy — the only route from this working copy to staging or production.
#
#   bin/deploy selftest                                  offline test of the path validator
#   bin/deploy check-env                                 list .env keys still holding placeholder values
#   bin/deploy <env> doctor                              read-only connectivity checks
#   bin/deploy <env> push [--dry-run] [--allow-dirty]    build, then upload theme + mu-plugins
#   bin/deploy <env> bootstrap --plan                    FIRST deploy: show what would be transferred
#   bin/deploy <env> bootstrap --confirm-bootstrap=<PROJECT_SLUG> [--with-db] [--no-uploads]
#                              [--no-plugins] [--dry-run]
#                                                        FIRST deploy: theme + mu-plugins + plugins in
#                                                        deploy-plugins.txt + uploads (+ database)
#   bin/deploy <env> wp <args…>                          remote wp-cli (ssh transport only)
#   bin/deploy <env> db-backup                           remote DB dump to .deploy-backups/ (ssh only)
#
#   <env> = staging | production
#
# bootstrap ALWAYS needs the user's confirmation: run --plan, show it, ask, then pass
# --confirm-bootstrap=<PROJECT_SLUG>. Production additionally requires --confirm-production=<PROJECT_SLUG> and is NEVER run by an agent
# unless the user explicitly asked for a production deploy in the current request.
#
# Authentication is ALWAYS by SSH key, for both transports — never a password. By default the keys
# already on this computer are used (ssh-agent, ~/.ssh/config, ~/.ssh/id_*); <ENV>_SSH_KEY may point
# to one specific private key instead. Password and keyboard-interactive auth are disabled, so a
# missing key fails fast instead of prompting.
#
# Every push runs the build first: build output is gitignored, so the working copy is never trusted
# to contain it. Config is read from .env (chmod 600, gitignored) — see .env.example.
#
# Compatible with the bash 3.2 that ships with macOS.

set -euo pipefail
IFS=$'\n\t'

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

BUILD_DIR=".deploy-build"
LOG_DIR=".deploy-logs"
BACKUP_DIR=".deploy-backups"

die()  { printf 'deploy: %s\n' "$*" >&2; exit 1; }
info() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }

# ---------------------------------------------------------------------------------------------
# guard_path <root> <relative-or-absolute path> — pure: no network, no filesystem.
# Only [A-Za-z0-9._/-]; no "." or ".." segment; result must sit under <root>.
guard_path() {
    local root="$1" path="$2" abs
    case "$root" in /*) ;; *) return 1 ;; esac
    case "$root" in *[!A-Za-z0-9._/-]*) return 1 ;; esac
    root="${root%/}"
    [[ -n "$root" ]] || return 1                     # "/" alone is never a valid root
    case "/${root#/}/" in */../*|*/./*) return 1 ;; esac
    [[ -n "$path" ]] || return 1
    case "$path" in *[!A-Za-z0-9._/-]*) return 1 ;; esac
    case "$path" in .) abs="$root" ;; /*) abs="$path" ;; *) abs="$root/$path" ;; esac
    abs="${abs%/}"
    case "/${abs#/}/" in */../*|*/./*) return 1 ;; esac
    [[ "$abs" == "$root" || "$abs" == "$root/"* ]] || return 1
    printf '%s\n' "$abs"
}

selftest() {
    local fail=0 r
    ok()  { if ! guard_path "$1" "$2" >/dev/null; then printf 'FAIL (rejected) %s | %s\n' "$1" "$2"; fail=1; fi; }
    bad() { if guard_path "$1" "$2" >/dev/null; then printf 'FAIL (accepted) %s | %s\n' "$1" "$2"; fail=1; fi; }
    r=/home/u/staging
    ok  "$r" wp-content/themes/acme
    ok  "$r" wp-content/mu-plugins/
    ok  "$r" "$r/wp-content"
    ok  "$r" .
    bad "$r" wp-content/../../prod
    bad "$r" ../staging2
    bad "$r" /home/u/staging2-evil
    bad "$r" /etc
    bad "$r" 'a$(x)'
    bad "$r" 'a`x`'
    bad "$r" 'a b'
    bad "$r" 'a;rm'
    bad "$r" ./wp-content
    bad "$r" ''
    bad /  wp-content
    bad relative/root wp-content
    bad /home/u/../root wp-content
    bad '/home/u/sta ging' wp-content
    [[ $fail -eq 0 ]] && echo "selftest: all cases pass" || die "selftest failed"
}

# ---------------------------------------------------------------------------------------------
# .env loader — parsed, never sourced (sourcing would execute whatever the file contains).
load_env() {
    [[ -f .env ]] || die ".env not found at repository root — copy .env.example and fill it in"
    local perms
    perms="$(stat -c %a .env 2>/dev/null || stat -f %Lp .env)"
    [[ "$perms" == 600 ]] || die ".env must be chmod 600 (currently $perms)"
    if git ls-files --error-unmatch .env >/dev/null 2>&1; then
        die ".env is TRACKED by git — run 'git rm --cached .env' and rotate any secret that was pushed"
    fi
    git check-ignore -q .env 2>/dev/null || die ".env is not gitignored — fix .gitignore first"
    if [[ -f .env.example ]] && git check-ignore -q .env.example 2>/dev/null; then
        warn ".env.example is gitignored — it must be tracked (add '!.env.example' to .gitignore)"
    fi
    local line key val
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
        [[ "$line" =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]] || die "malformed line in .env (key: ${line%%=*})"
        key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
        if   [[ "$val" =~ ^\"([^\"]*)\" ]]; then val="${BASH_REMATCH[1]}"
        elif [[ "$val" =~ ^\'([^\']*)\' ]]; then val="${BASH_REMATCH[1]}"
        else
            val="${val%%[[:space:]]#*}"
            val="${val%"${val##*[![:space:]]}"}"
        fi
        # shellcheck disable=SC2088  # literal "~/" prefix match is intended
        case "$val" in "~/"*) val="$HOME/${val#\~/}" ;; esac
        printf -v "$key" '%s' "$val"
    done < .env
    : "${PROJECT_SLUG:?PROJECT_SLUG missing in .env}"
    : "${THEME_DIR:?THEME_DIR missing in .env}"
    MU_PLUGINS_DIR="${MU_PLUGINS_DIR:-wp-content/mu-plugins}"
}

envvar() { local n="${PREFIX}_$1"; printf '%s' "${!n:-}"; }

# A value containing "example" or "CHANGE_ME" is a placeholder from .env.example: treat it as unset.
is_placeholder() { case "$1" in ""|*example*|*CHANGE_ME*) return 0 ;; *) return 1 ;; esac; }

check_env() {
    local key val missing=0 env keys
    for env in STAGING PRODUCTION; do
        keys=(URL TRANSPORT HOST PORT USER ROOT)
        for key in "${keys[@]}"; do
            val="${env}_${key}"; val="${!val:-}"
            if is_placeholder "$val"; then printf '  ✗ %s_%s\n' "$env" "$key"; missing=1; fi
        done
        val="${env}_SSH_KEY"; val="${!val:-default}"
        if [[ "$val" != default ]] && { is_placeholder "$val" || [[ ! -f "$val" ]]; }; then
            printf '  ✗ %s_SSH_KEY (not "default" and no key file at that path)\n' "$env"; missing=1
        fi
    done
    for key in PROJECT_SLUG THEME_DIR; do
        is_placeholder "${!key:-}" && { printf '  ✗ %s\n' "$key"; missing=1; }
    done
    if [[ $missing -eq 0 ]]; then echo "check-env: staging and production fully configured"; else echo "check-env: the keys above still hold placeholder values"; fi
    return 0
}

select_env() {
    case "$1" in
        staging)    PREFIX=STAGING ;;
        production) PREFIX=PRODUCTION ;;
        *) die "unknown environment '$1' (staging|production)" ;;
    esac
    ENV_NAME="$1"
    TRANSPORT="$(envvar TRANSPORT)"; HOST="$(envvar HOST)"; PORT="$(envvar PORT)"
    RUSER="$(envvar USER)"; KEY="$(envvar SSH_KEY)"; RROOT="$(envvar ROOT)"
    PORT="${PORT:-22}"; TRANSPORT="${TRANSPORT:-ssh}"
    local k
    for k in HOST USER ROOT; do
        is_placeholder "$(envvar "$k")" && die "${PREFIX}_$k in .env is still a placeholder — set the real value (bin/deploy check-env)"
    done
    [[ -n "$HOST" && -n "$RUSER" && -n "$RROOT" ]] || die "${PREFIX}_HOST/_USER/_ROOT must be set in .env"
    case "$HOST"  in *[!A-Za-z0-9._-]*) die "${PREFIX}_HOST contains invalid characters" ;; esac   # a ~/.ssh/config alias is fine
    case "$RUSER" in *[!A-Za-z0-9._-]*) die "${PREFIX}_USER contains invalid characters" ;; esac
    case "$PORT"  in *[!0-9]*) die "${PREFIX}_PORT must be numeric" ;; esac
    RROOT="$(guard_path "$RROOT" .)" || die "${PREFIX}_ROOT is not a valid absolute path"
    # SSH key: "default" (or empty) = the keys already on this computer; otherwise a key file path.
    case "$KEY" in ""|default) KEY="" ;; esac
    if [[ -n "$KEY" ]]; then
        is_placeholder "$KEY" && die "${PREFIX}_SSH_KEY is still a placeholder — use \"default\" or a real key path"
        [[ -f "$KEY" ]] || die "${PREFIX}_SSH_KEY: no key file at $KEY"
    fi
    case "$TRANSPORT" in
        ssh)  ;;
        sftp) command -v lftp >/dev/null || die "sftp transport needs lftp (brew install lftp)" ;;
        *) die "${PREFIX}_TRANSPORT must be ssh or sftp" ;;
    esac
}

log() {
    mkdir -p "$LOG_DIR"
    printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$ENV_NAME" \
        "$(git rev-parse --short HEAD 2>/dev/null || echo no-git)" "${USER:-?}" "$*" >> "$LOG_DIR/deploy.log"
}

SSH_OPTS=()
# Key-only authentication: never prompt for a password, fail fast if no key is accepted.
ssh_auth_opts() {
    SSH_OPTS=(-o BatchMode=yes -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no
              -o PreferredAuthentications=publickey -o ConnectTimeout=15)
    if [[ -n "$KEY" ]]; then SSH_OPTS+=(-i "$KEY" -o IdentitiesOnly=yes); fi
    return 0
}
ssh_opts() { ssh_auth_opts; SSH_OPTS=(-p "$PORT" "${SSH_OPTS[@]}"); }
ssh_e()    { local IFS=' '; ssh_opts; printf 'ssh %s' "${SSH_OPTS[*]}"; }   # for rsync -e (IFS is \n\t globally)

remote_sh() {   # remote_sh <already-quoted command string>
    [[ "$TRANSPORT" == ssh ]] || die "this command needs the ssh transport"
    ssh_opts
    ssh "${SSH_OPTS[@]}" "$RUSER@$HOST" "$1"
}

remote_wp() {
    local q="" a
    for a in "$@"; do q+="$(printf '%q' "$a") "; done
    remote_sh "cd $(printf '%q' "$RROOT") && wp --path=$(printf '%q' "$RROOT") $q"
}

lftp_run() {    # lftp_run <lftp script> — sftp over ssh, same key-only authentication as above
    local o connect="ssh -a -x"
    ssh_auth_opts
    for o in "${SSH_OPTS[@]}"; do connect+=" $(printf '%q' "$o")"; done
    # "user," = empty password: lftp never asks for one; lftp adds -p/-l to the connect program itself.
    lftp -u "$RUSER," -p "$PORT" \
         -e "set sftp:auto-confirm yes; set net:max-retries 2; set sftp:connect-program \"$connect\"; $1; bye" \
         "sftp://$HOST"
}

# ---------------------------------------------------------------------------------------------
build_release() {
    info "Building theme assets ($THEME_DIR)"
    [[ -f "$THEME_DIR/package.json" ]] || die "$THEME_DIR/package.json not found — check THEME_DIR"
    ( cd "$THEME_DIR" && { [[ -d node_modules ]] || npm ci --no-audit --no-fund; } && npm run build )

    info "Assembling release in $BUILD_DIR/"
    # Synced in place with --delete, never rm -rf'd: a directory deleted and recreated at once can
    # look stale to a container (Docker Desktop file sharing on macOS) running LOCAL_COMPOSER_CMD.
    # vendor/ is excluded, so rsync keeps it and `composer install` reconciles it with the lock file.
    mkdir -p "$BUILD_DIR/theme" "$BUILD_DIR/mu-plugins"
    rsync -a --delete \
        --exclude node_modules --exclude vendor --exclude .git --exclude tests \
        --exclude '.env*' --exclude .DS_Store --exclude '*.log' \
        "$THEME_DIR/" "$BUILD_DIR/theme/"
    if [[ -f "$BUILD_DIR/theme/composer.json" ]]; then
        # LOCAL_COMPOSER_CMD runs composer where it lives: "composer" on the host, or e.g.
        # "docker exec -w <repo root in container> <php container> composer". The working dir is
        # passed RELATIVE to the repository root, so it resolves the same on host and in container.
        # Split on spaces only (the script's IFS is newline/tab); no quoting inside the value.
        # Unset and no host composer: derive it from LOCAL_WP_CMD when that is a container command
        # ending in "wp" (same container, same working dir) — "docker exec … php wp" → "… php composer".
        if [[ -z "${LOCAL_COMPOSER_CMD:-}" ]] && ! command -v composer >/dev/null \
            && [[ "${LOCAL_WP_CMD:-}" == *" wp" && "${LOCAL_WP_CMD:-}" != "wp" ]]; then
            LOCAL_COMPOSER_CMD="${LOCAL_WP_CMD% wp} composer"
            info "composer via LOCAL_WP_CMD's container: $LOCAL_COMPOSER_CMD"
        fi
        local -a composer_cmd
        IFS=' ' read -r -a composer_cmd <<< "${LOCAL_COMPOSER_CMD:-composer}"
        command -v "${composer_cmd[0]}" >/dev/null \
            || die "'${composer_cmd[0]}' not found — install composer or set LOCAL_COMPOSER_CMD in .env"
        "${composer_cmd[@]}" install --no-dev --optimize-autoloader --no-interaction --no-progress \
            --working-dir="$BUILD_DIR/theme" >/dev/null \
            || die "composer install failed in $BUILD_DIR/theme (LOCAL_COMPOSER_CMD: ${LOCAL_COMPOSER_CMD:-composer})"
        [[ -f "$BUILD_DIR/theme/vendor/autoload.php" ]] || die "vendor/autoload.php missing after composer install"
    fi
    [[ -f "$BUILD_DIR/theme/public/build/manifest.json" ]] || die "Vite manifest missing after build"
    if [[ -d "$THEME_DIR/resources/js/blocks" ]]; then
        [[ -f "$BUILD_DIR/theme/public/blocks/index.asset.php" ]] || die "block bundle missing after build"
    fi
    [[ -d "$MU_PLUGINS_DIR" ]] && rsync -a --delete --exclude tests --exclude .DS_Store "$MU_PLUGINS_DIR/" "$BUILD_DIR/mu-plugins/"
    return 0
}

backup_remote() {
    local ts dir; ts="$(date +%Y%m%d-%H%M%S)"; dir="$BACKUP_DIR/$PROJECT_SLUG-$ENV_NAME-$ts"
    mkdir -p "$dir"
    local rtheme; rtheme="$(guard_path "$RROOT" "$THEME_DIR")" || die "THEME_DIR fails path validation"
    info "Backing up remote theme to $dir/theme"
    if [[ "$TRANSPORT" == ssh ]]; then
        ssh_opts
        rsync -az -e "$(ssh_e)" "$RUSER@$HOST:$rtheme/" "$dir/theme/" || warn "no remote theme yet (first deploy?)"
        info "Backing up remote database"
        remote_wp db export - > "$dir/db.sql"
        [[ -s "$dir/db.sql" ]] || die "remote database backup is empty ($dir/db.sql): stopping"
    else
        lftp_run "mirror --parallel=4 $(printf '%q' "$rtheme") $(printf '%q' "$dir/theme")" || warn "no remote theme yet (first deploy?)"
        warn "sftp transport: no database backup possible — take one from the hosting panel if the release touches data"
    fi
}

push() {
    local dry="" allow_dirty="" confirm="" a
    for a in "$@"; do
        case "$a" in
            -n|--dry-run)            dry=1 ;;
            --allow-dirty)           allow_dirty=1 ;;
            --confirm-production=*)  confirm="${a#*=}" ;;
            *) die "unknown option '$a'" ;;
        esac
    done

    if [[ "$ENV_NAME" == production && -z "$dry" ]]; then
        [[ "$confirm" == "$PROJECT_SLUG" ]] \
            || die "production push requires --confirm-production=$PROJECT_SLUG (explicit request only)"
        if [[ -z "$allow_dirty" && -n "$(git status --porcelain 2>/dev/null)" ]]; then
            die "working tree has uncommitted changes — commit them first or pass --allow-dirty"
        fi
    fi

    build_release

    local rtheme rmu
    rtheme="$(guard_path "$RROOT" "$THEME_DIR")"      || die "THEME_DIR fails path validation"
    rmu="$(guard_path "$RROOT" "$MU_PLUGINS_DIR")"    || die "MU_PLUGINS_DIR fails path validation"

    [[ "$ENV_NAME" == production && -z "$dry" ]] && backup_remote

    info "Uploading to $ENV_NAME via $TRANSPORT${dry:+ (dry run)}"
    if [[ "$TRANSPORT" == ssh ]]; then
        ssh_opts
        local ropts=(-az --itemize-changes -e "$(ssh_e)")
        [[ -n "$dry" ]] && ropts+=(--dry-run)
        rsync "${ropts[@]}" --delete "$BUILD_DIR/theme/" "$RUSER@$HOST:$rtheme/"
        # mu-plugins: no --delete — hosts often install their own there.
        [[ -n "$(ls -A "$BUILD_DIR/mu-plugins")" ]] && rsync "${ropts[@]}" "$BUILD_DIR/mu-plugins/" "$RUSER@$HOST:$rmu/"
        if [[ -z "$dry" ]]; then
            info "Refreshing Acorn caches"
            remote_wp acorn optimize || warn "wp acorn optimize failed — run it manually"
        fi
    else
        local d=""; [[ -n "$dry" ]] && d="--dry-run"
        lftp_run "mirror --reverse --delete --verbose --parallel=4 $d $(printf '%q' "$BUILD_DIR/theme") $(printf '%q' "$rtheme")"
        [[ -n "$(ls -A "$BUILD_DIR/mu-plugins")" ]] && \
            lftp_run "mirror --reverse --verbose $d $(printf '%q' "$BUILD_DIR/mu-plugins") $(printf '%q' "$rmu")"
        [[ -z "$dry" ]] && warn "sftp transport: run 'wp acorn optimize' and purge the page cache from the hosting panel"
    fi

    log "push${dry:+ dry-run}"
    info "Done: $ENV_NAME ${dry:+(dry run) }— $(envvar URL)"
}

remote_dir_exists() {   # remote_dir_exists <absolute remote path>
    if [[ "$TRANSPORT" == ssh ]]; then
        remote_sh "test -d $(printf '%q' "$1")" 2>/dev/null
    else
        lftp_run "cls -d $(printf '%q' "$1")" >/dev/null 2>&1
    fi
}

transfer() {   # transfer <local dir> <repo-relative remote dir> <delete:0|1> <dry:""|1>
    local src="$1" rel="$2" del="$3" dry="$4" dst
    dst="$(guard_path "$RROOT" "$rel")" || die "remote path fails validation: $rel"
    [[ -d "$src" ]] || die "local directory not found: $src"
    if [[ "$TRANSPORT" == ssh ]]; then
        local ropts=(-az --itemize-changes --exclude .git --exclude .DS_Store -e "$(ssh_e)")
        [[ -n "$dry" ]] && ropts+=(--dry-run)
        [[ "$del" == 1 ]] && ropts+=(--delete)
        rsync "${ropts[@]}" "$src/" "$RUSER@$HOST:$dst/"
    else
        local d="" x=""
        [[ -n "$dry" ]] && d="--dry-run"
        [[ "$del" == 1 ]] && x="--delete"
        lftp_run "mirror --reverse $x --verbose --parallel=4 --exclude-glob .git/ --exclude-glob .DS_Store $d $(printf '%q' "$src") $(printf '%q' "$dst")"
    fi
}

read_plugin_list() {   # prints one plugin slug per line from deploy-plugins.txt
    [[ -f deploy-plugins.txt ]] || return 0
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"; line="${line//[[:space:]]/}"
        [[ -z "$line" ]] && continue
        case "$line" in *[!a-z0-9_-]*) die "deploy-plugins.txt: invalid plugin slug '$line'" ;; esac
        printf '%s\n' "$line"
    done < deploy-plugins.txt
}

local_wp() {   # local_wp <args…> — runs LOCAL_WP_CMD (e.g. "wp", "ddev wp") from the repo root
    local IFS=' ' base
    read -r -a base <<< "${LOCAL_WP_CMD:-wp}"
    "${base[@]}" "$@"
}

bootstrap() {
    local plan="" dry="" with_db="" no_uploads="" no_plugins="" confirm="" confirm_prod="" a
    for a in "$@"; do
        case "$a" in
            --plan)                  plan=1 ;;
            -n|--dry-run)            dry=1 ;;
            --with-db)               with_db=1 ;;
            --no-uploads)            no_uploads=1 ;;
            --no-plugins)            no_plugins=1 ;;
            --confirm-bootstrap=*)   confirm="${a#*=}" ;;
            --confirm-production=*)  confirm_prod="${a#*=}" ;;
            *) die "unknown option '$a'" ;;
        esac
    done

    local plugins=() p theme_slug local_url remote_url uploads="wp-content/uploads"
    if [[ -z "$no_plugins" ]]; then
        while IFS= read -r p; do [[ -n "$p" ]] && plugins+=("$p"); done < <(read_plugin_list)
        for p in "${plugins[@]+"${plugins[@]}"}"; do
            [[ -d "wp-content/plugins/$p" ]] || die "plugin '$p' listed in deploy-plugins.txt is not in wp-content/plugins/"
        done
    fi
    theme_slug="$(basename "$THEME_DIR")"
    local_url="${LOCAL_URL:-}"; remote_url="$(envvar URL)"
    is_placeholder "$remote_url" && die "${PREFIX}_URL is still a placeholder"
    if [[ -n "$with_db" ]]; then
        [[ "$TRANSPORT" == ssh ]] || die "--with-db needs the ssh transport (remote wp-cli); over sftp import the DB from the hosting panel"
        is_placeholder "$local_url" && die "LOCAL_URL is still a placeholder — needed for the URL search-replace"
    fi

    # ---- the plan: always printed, and the only output of --plan ------------------------------
    info "FIRST DEPLOY (bootstrap) → $ENV_NAME  ($remote_url, $TRANSPORT://$RUSER@$HOST$RROOT)"
    printf '  %-12s %s\n' "theme"      "$THEME_DIR  (built: npm run build + composer --no-dev)  $(du -sh "$THEME_DIR" 2>/dev/null | cut -f1)"
    printf '  %-12s %s\n' "mu-plugins" "$MU_PLUGINS_DIR  $(du -sh "$MU_PLUGINS_DIR" 2>/dev/null | cut -f1)"
    if [[ -n "$no_plugins" ]]; then printf '  %-12s %s\n' "plugins" "skipped (--no-plugins)"
    elif [[ ${#plugins[@]} -eq 0 ]]; then printf '  %-12s %s\n' "plugins" "none (deploy-plugins.txt empty or missing)"
    else for p in "${plugins[@]}"; do printf '  %-12s %s\n' "plugin" "wp-content/plugins/$p  $(du -sh "wp-content/plugins/$p" | cut -f1)"; done; fi
    if [[ -n "$no_uploads" ]]; then printf '  %-12s %s\n' "uploads" "skipped (--no-uploads)"
    elif [[ -d "$uploads" ]]; then printf '  %-12s %s\n' "uploads" "$uploads  $(du -sh "$uploads" | cut -f1)  (added/updated, never deleted remotely)"
    else printf '  %-12s %s\n' "uploads" "none locally"; fi
    if [[ -n "$with_db" ]]; then
        printf '  %-12s %s\n' "database" "local DB REPLACES the remote DB (remote backup first); $local_url → $remote_url"
        printf '  %-12s %s\n' "" "remote users become the local ones; staging is set to discourage search engines"
    else printf '  %-12s %s\n' "database" "not transferred (add --with-db)"; fi
    if remote_dir_exists "$(guard_path "$RROOT" "$THEME_DIR")"; then
        warn "the theme already exists on $ENV_NAME — this is not a first deploy; 'push' is usually what you want"
    fi
    if [[ -n "$plan" ]]; then
        echo; echo "Plan only. Ask the user to confirm, then run with --confirm-bootstrap=$PROJECT_SLUG"
        return 0
    fi

    # ---- gates --------------------------------------------------------------------------------
    if [[ -z "$dry" ]]; then
        [[ "$confirm" == "$PROJECT_SLUG" ]] \
            || die "bootstrap requires the user's confirmation: show 'bootstrap --plan', then pass --confirm-bootstrap=$PROJECT_SLUG"
    fi
    local push_args=()
    [[ -n "$dry" ]] && push_args+=(--dry-run)
    [[ -n "$confirm_prod" ]] && push_args+=("--confirm-production=$confirm_prod")
    if [[ "$ENV_NAME" == production && -z "$dry" ]]; then
        [[ "$confirm_prod" == "$PROJECT_SLUG" ]] || die "production bootstrap also requires --confirm-production=$PROJECT_SLUG"
    fi

    # ---- 1. database backup before anything can overwrite it ----------------------------------
    [[ -n "$with_db" && -z "$dry" && "$ENV_NAME" != production ]] && backup_remote   # production: push does it

    # ---- 2. theme + mu-plugins (build included) -------------------------------------------------
    push "${push_args[@]+"${push_args[@]}"}"

    # ---- 3. plugins -----------------------------------------------------------------------------
    for p in "${plugins[@]+"${plugins[@]}"}"; do
        info "Plugin: $p"
        transfer "wp-content/plugins/$p" "wp-content/plugins/$p" 1 "$dry"
    done

    # ---- 4. uploads -----------------------------------------------------------------------------
    if [[ -z "$no_uploads" && -d "$uploads" ]]; then
        info "Uploads"
        transfer "$uploads" "$uploads" 0 "$dry"
    fi

    # ---- 5. database ----------------------------------------------------------------------------
    if [[ -n "$with_db" && -z "$dry" ]]; then
        local dump="$BUILD_DIR/db.sql" lprefix rprefix esc_l esc_r
        lprefix="$(local_wp config get table_prefix 2>/dev/null | tail -1)"
        rprefix="$(remote_wp config get table_prefix 2>/dev/null | tail -1)"
        [[ -n "$lprefix" && "$lprefix" == "$rprefix" ]] \
            || die "table prefix differs (local '$lprefix', remote '$rprefix') — align \$table_prefix in the remote wp-config.php first"
        info "Exporting local database"
        local_wp db export - > "$dump"
        [[ -s "$dump" ]] || die "local database export is empty"
        info "Importing into $ENV_NAME"
        remote_wp db import - < "$dump"
        info "Replacing $local_url → $remote_url"
        remote_wp search-replace "$local_url" "$remote_url" --all-tables-with-prefix --skip-columns=guid --precise --report-changed-only
        esc_l="${local_url//\//\\\/}"; esc_r="${remote_url//\//\\\/}"      # JSON-escaped form used in block attributes
        remote_wp search-replace "$esc_l" "$esc_r" --all-tables-with-prefix --skip-columns=guid --precise --report-changed-only
        rm -f "$dump"
    fi

    # ---- 6. activate and refresh (ssh) ----------------------------------------------------------
    if [[ -z "$dry" ]]; then
        if [[ "$TRANSPORT" == ssh ]]; then
            remote_wp theme activate "$theme_slug"
            [[ ${#plugins[@]} -gt 0 ]] && remote_wp plugin activate "${plugins[@]}"
            [[ "$ENV_NAME" == staging ]] && remote_wp option update blog_public 0
            remote_wp rewrite flush || true
            remote_wp acorn optimize || warn "wp acorn optimize failed — run it manually"
        else
            warn "sftp transport: activate the theme '$theme_slug' and the plugins from wp-admin; on staging tick 'Discourage search engines'"
        fi
    fi

    log "bootstrap${dry:+ dry-run} plugins=${#plugins[@]} uploads=$([[ -z "$no_uploads" ]] && echo yes || echo no) db=$([[ -n "$with_db" ]] && echo yes || echo no)"
    info "Bootstrap done: $ENV_NAME ${dry:+(dry run) }— $remote_url"
}

doctor() {
    info "$ENV_NAME: $TRANSPORT://$RUSER@$HOST:$PORT$RROOT (key: ${KEY:-default keys on this computer})"
    ssh_opts
    if [[ "$TRANSPORT" == sftp ]]; then
        : # sftp-only hosts often refuse a shell command: the lftp listing below tests the key instead
    elif ssh "${SSH_OPTS[@]}" "$RUSER@$HOST" true 2>/dev/null; then
        echo "  ssh key authentication: ok"
    else
        die "ssh key authentication failed — load the key (ssh-add --apple-use-keychain ~/.ssh/<key>), check ~/.ssh/config, or set ${PREFIX}_SSH_KEY; the server must have the public key in ~/.ssh/authorized_keys"
    fi
    if [[ "$TRANSPORT" == ssh ]]; then
        remote_sh "test -f $(printf '%q' "$RROOT/wp-config.php")" && echo "  wp-config.php: found" || die "wp-config.php not found under ROOT"
        remote_wp core version >/dev/null && echo "  wp-cli: ok" || die "wp-cli not available remotely"
        remote_wp db check >/dev/null && echo "  database: ok" || die "database check failed"
    else
        lftp_run "cls -1 $(printf '%q' "$RROOT/wp-config.php")" >/dev/null && echo "  sftp key authentication + wp-config.php: ok" \
            || die "sftp failed — key not accepted (ssh-add, ~/.ssh/config, ${PREFIX}_SSH_KEY) or wp-config.php not under ROOT"
        echo "  wp-cli / database: not checkable over sftp"
    fi
}

# ---------------------------------------------------------------------------------------------
[[ $# -ge 1 ]] || { sed -n '3,12p' "$0"; exit 1; }
case "$1" in
    selftest) selftest; exit 0 ;;
    -h|--help|help) sed -n '3,18p' "$0"; exit 0 ;;
esac

load_env
if [[ "$1" == check-env ]]; then check_env; exit 0; fi
for k in PROJECT_SLUG THEME_DIR; do
    is_placeholder "${!k}" && die "$k in .env is still a placeholder — set the real value (bin/deploy check-env)"
done
select_env "$1"; shift
cmd="${1:-}"; shift || true
case "$cmd" in
    doctor)    doctor ;;
    push)      push "$@" ;;
    bootstrap) bootstrap "$@" ;;
    wp)        [[ $# -ge 1 ]] || die "usage: bin/deploy <env> wp <args…>"
               if [[ "$ENV_NAME" == production ]]; then
                   case "${1:-}" in
                       option|core|plugin|theme|user|post|search-replace|db|eval|eval-file|shell|config)
                           warn "production wp-cli: '$1' can change data — agents run this only on explicit request" ;;
                   esac
               fi
               remote_wp "$@"; log "wp $1" ;;
    db-backup) backup_remote ;;
    *) die "unknown command '$cmd' (doctor | push | bootstrap | wp | db-backup)" ;;
esac
