#!/usr/bin/env bash
#
# bin/deploy — the only route from this working copy to staging or production.
#
# The environment is ALWAYS the first argument and has no default: forgetting it is an error, not a
# run against the wrong server.
#
#   bin/deploy <env> doctor                              read-only checks: key, wp-config, wp-cli, DB
#   bin/deploy <env> push [--dry-run] [--allow-dirty]    back up, build, upload theme + mu-plugins
#   bin/deploy <env> bootstrap --plan                    FIRST deploy: show what would be transferred
#   bin/deploy <env> bootstrap --confirm-bootstrap=<PROJECT_SLUG> [--with-db] [--no-uploads]
#                              [--no-plugins] [--dry-run]
#                                                        FIRST deploy: theme + mu-plugins + MISSING
#                                                        plugins from deploy-plugins.txt + uploads (+ DB)
#   bin/deploy <env> wp <args…>                          remote wp-cli (ssh transport only)
#   bin/deploy <env> eval-file <file.php> [args…]        run a local wp-cli script remotely (ssh only)
#   bin/deploy <env> backup                              back up now (the same snapshot every deploy takes)
#   bin/deploy <env> backups                             list the local backups for <env>
#   bin/deploy <env> restore <id|latest> --confirm-restore=<PROJECT_SLUG> [--files-only|--db-only]
#                              [--dry-run]               put a backup back on the server
#
#   <env> = staging | production
#
# Without an environment:
#   bin/deploy selftest                                  offline tests: paths, conf isolation, refusals
#   bin/deploy init                                      create ~/.config/<slug>/ (700) + conf templates (600)
#   bin/deploy check-env                                 list conf keys still holding placeholder values
#   bin/deploy key-setup <env> [--passphrase]            create the dedicated SSH key, print the .pub
#   bin/deploy migrate-env [--delete-env]                move a legacy .env into the per-env confs
#   bin/deploy clone-from-prod --confirm-clone=<PROJECT_SLUG>
#                                                        staging := copy of production (DB), one way only
#
# CONFIG LIVES OUTSIDE THE REPOSITORY, in ~/.config/<PROJECT_SLUG>/ (dir 700, files 600 — enforced):
#   staging.conf, production.conf   one per environment (template: bin/deploy.conf.example)
#   local.conf                      this machine: LOCAL_URL (https), LOCAL_WP_CMD… (bin/deploy.local.conf.example)
#   backups/ dumps/ deploy.log      database dumps hold personal data and password hashes: never in the repo
# The only project fact in this file is PROJECT_SLUG. Confs are PARSED, never sourced, and every
# conf load starts from a clean slate, so a command that loads two confs cannot inherit values.
# No password anywhere: SSH key only (a dedicated one per project and environment, IdentitiesOnly);
# remote DB credentials are read by wp-cli from the server's wp-config.php, local ones from the local
# wp-config.php.
#
# bootstrap, restore and clone-from-prod ALWAYS need the user's confirmation. Production additionally
# requires --confirm-production=<PROJECT_SLUG> and is NEVER run by an agent unless the user explicitly
# asked for it in the current request; overwriting the production database is refused by the code.
#
# Every deploy (push, bootstrap, eval-file) first backs up what it can overwrite — remote theme,
# mu-plugins and (ssh) the database. If the backup fails, the deploy does not start.
#
# Compatible with the bash 3.2 that ships with macOS.

set -euo pipefail
IFS=$'\n\t'

# ---- the ONLY project-specific lines of this file (set at kickoff) -----------------------------
PROJECT_SLUG="example-project"          # lowercase slug: names ~/.config/<slug>/ and the SSH keys
THEME_SLUG="$PROJECT_SLUG"              # theme folder name, if it ever differs from the project slug
# -------------------------------------------------------------------------------------------------

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

THEME_DIR="wp-content/themes/$THEME_SLUG"
MU_PLUGINS_DIR="wp-content/mu-plugins"
CONF_DIR="${DEPLOY_CONF_DIR:-$HOME/.config/$PROJECT_SLUG}"
BACKUP_DIR="$CONF_DIR/backups"
DUMP_DIR="$CONF_DIR/dumps"
LOG_FILE="$CONF_DIR/deploy.log"
BUILD_DIR=".deploy-build"               # built theme only — no data, no config

die()  { printf 'deploy: %s\n' "$*" >&2; exit 1; }
info() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }

# ---------------------------------------------------------------------------------------------
# guard_path <root> <relative-or-absolute path> — pure: no network, no filesystem.
# Only [A-Za-z0-9._/-]; no "." or ".." segment; result must sit under <root>.
guard_path() {
    local root="$1" path="$2" abs
    case "$root" in /*) ;; *) return 1 ;; esac
    case "$root" in *[!A-Za-z0-9._/-]*) return 1 ;; esac
    root="${root%/}"
    [[ -n "$root" ]] || return 1                     # "/" alone is never a valid root
    case "/${root#/}/" in */../*|*/./*) return 1 ;; esac
    [[ -n "$path" ]] || return 1
    case "$path" in *[!A-Za-z0-9._/-]*) return 1 ;; esac
    case "$path" in .) abs="$root" ;; /*) abs="$path" ;; *) abs="$root/$path" ;; esac
    abs="${abs%/}"
    case "/${abs#/}/" in */../*|*/./*) return 1 ;; esac
    [[ "$abs" == "$root" || "$abs" == "$root/"* ]] || return 1
    printf '%s\n' "$abs"
}

selftest() {
    local pass=0 fail=0 r
    ok()  { if guard_path "$1" "$2" >/dev/null; then pass=$((pass+1)); else printf 'FAIL (rejected) %s | %s\n' "$1" "$2"; fail=$((fail+1)); fi; }
    bad() { if guard_path "$1" "$2" >/dev/null; then printf 'FAIL (accepted) %s | %s\n' "$1" "$2"; fail=$((fail+1)); else pass=$((pass+1)); fi; }
    r=/home/u/staging
    ok  "$r" wp-content/themes/acme
    ok  "$r" wp-content/mu-plugins/
    ok  "$r" "$r/wp-content"
    ok  "$r" .
    bad "$r" wp-content/../../prod
    bad "$r" ../staging2
    bad "$r" /home/u/staging2-evil
    bad "$r" /etc
    bad "$r" 'a$(x)'
    bad "$r" 'a`x`'
    bad "$r" 'a b'
    bad "$r" 'a;rm'
    bad "$r" ./wp-content
    bad "$r" ''
    bad /  wp-content
    bad relative/root wp-content
    bad /home/u/../root wp-content
    bad '/home/u/sta ging' wp-content

    # ---- conf isolation: two loads in a row must not contaminate each other. The second conf
    # omits port, transport and key, and the first carries a key that belongs in local.conf.
    local dir
    dir="$(mktemp -d)"; chmod 700 "$dir"
    cat > "$dir/staging.conf" <<CONF_B
DEPLOY_HOST=host-b
DEPLOY_USER=user-b
DEPLOY_ROOT=/home/u/b
DEPLOY_URL=https://b.acme.test
CONF_B
    cat > "$dir/production.conf" <<CONF_A
DEPLOY_HOST=host-a
DEPLOY_USER=user-a
DEPLOY_ROOT=/home/u/a
DEPLOY_URL=https://a.acme.test
DEPLOY_PORT=2201
DEPLOY_TRANSPORT=sftp
DEPLOY_KEY=$dir/key-a
LOCAL_URL=https://leak.acme.test
CONF_A
    chmod 600 "$dir/staging.conf" "$dir/production.conf"
    local got
    got="$( CONF_DIR="$dir"
            read_env_conf production 2>/dev/null
            read_env_conf staging 2>/dev/null
            printf '%s|%s|%s|%s|%s|%s|%s|%s' "$HOST" "$RUSER" "$RROOT" "$URL" "$PORT" "$TRANSPORT" "$KEY" "${LOCAL_URL:-}" )"
    if [[ "$got" == "host-b|user-b|/home/u/b|https://b.acme.test|22|ssh|$(default_key staging)|" ]]; then
        pass=$((pass+1))
    else
        printf 'FAIL conf_isolation: staging inherited values from production.conf\n'; fail=$((fail+1))
    fi
    # permissions are enforced: a 644 conf is refused
    chmod 644 "$dir/staging.conf"
    if ( CONF_DIR="$dir"; read_env_conf staging ) >/dev/null 2>&1; then
        printf 'FAIL conf_perms: a 644 conf was accepted\n'; fail=$((fail+1)); else pass=$((pass+1)); fi
    rm -rf "$dir"

    # ---- LOCAL_URL must be real and https
    lu_ok() { if ( LOCAL_URL="$1"; CONF_DIR=/nonexistent; require_local_url ) >/dev/null 2>&1; then pass=$((pass+1)); else printf 'FAIL require_local_url "%s" rejected\n' "$1"; fail=$((fail+1)); fi; }
    lu_ko() { if ( LOCAL_URL="$1"; CONF_DIR=/nonexistent; require_local_url ) >/dev/null 2>&1; then printf 'FAIL require_local_url "%s" accepted\n' "$1"; fail=$((fail+1)); else pass=$((pass+1)); fi; }
    lu_ok https://acme.test
    lu_ok https://acme.test/
    lu_ko http://acme.test
    lu_ko acme.test
    lu_ko ""
    lu_ko https://example-project.test

    # ---- refusals: each runs this script in a subprocess against a config dir that does not
    # exist, so a missing refusal fails on the config instead of touching a server.
    refuses() {
        local why="$1" needle="$2" out; shift 2
        if out="$(DEPLOY_CONF_DIR=/nonexistent/deploy-selftest "$SELF" "$@" 2>&1)"; then
            printf 'FAIL %s: accepted\n' "$why"; fail=$((fail+1))
        elif [[ "$out" != *"$needle"* ]]; then
            printf 'FAIL %s: refused for the wrong reason: %s\n' "$why" "$out"; fail=$((fail+1))
        else pass=$((pass+1)); fi
    }
    refuses 'no environment'               'missing environment'     push
    refuses 'invented environment'         'unknown environment'     prod push
    refuses 'production bootstrap --with-db' 'never overwritten'     production bootstrap --with-db --confirm-bootstrap=x
    refuses 'production restore w/o prod confirm' 'confirm-production' production restore latest --confirm-restore=x
    refuses 'clone without confirmation'   'confirm-clone'           clone-from-prod
    refuses 'key-setup without env'        'usage: bin/deploy key-setup' key-setup

    printf 'selftest: %d ok, %d failed\n' "$pass" "$fail"
    [[ $fail -eq 0 ]] || die "selftest failed"
}

# ---------------------------------------------------------------------------------------------
# Config layer. Keys each file may set — anything else is ignored with a warning (name only).
ENV_KEYS="DEPLOY_TRANSPORT DEPLOY_HOST DEPLOY_PORT DEPLOY_USER DEPLOY_KEY DEPLOY_ROOT DEPLOY_URL"
LOCAL_KEYS="LOCAL_URL LOCAL_WP_CMD LOCAL_COMPOSER_CMD BACKUP_KEEP"
DERIVED_VARS="ENV_NAME CONF TRANSPORT HOST PORT RUSER KEY RROOT URL"

# A value containing "example" or "CHANGE_ME" is a placeholder from a template: treat it as unset.
is_placeholder() { case "$1" in ""|*example*|*CHANGE_ME*) return 0 ;; *) return 1 ;; esac; }

perms_of() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1"; }

check_conf_dir() {
    [[ -d "$CONF_DIR" ]] || die "config directory $CONF_DIR not found — run: bin/deploy init"
    [[ "$(perms_of "$CONF_DIR")" == 700 ]] || die "$CONF_DIR must be chmod 700 (is $(perms_of "$CONF_DIR"))"
}

check_conf_file() {
    [[ -f "$1" ]] || die "config file $1 not found — run: bin/deploy init"
    [[ "$(perms_of "$1")" == 600 ]] || die "$1 must be chmod 600 (is $(perms_of "$1"))"
}

# parse_conf <file> <allowed keys> — KEY=value lines; quotes stripped; "~/" expanded. Never sourced.
parse_conf() {
    local file="$1" allowed line key val
    allowed=" $(printf '%s' "$2" | tr '\n' ' ') "
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
        [[ "$line" =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]] || die "malformed line in $file (key: ${line%%=*})"
        key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
        if   [[ "$val" =~ ^\"([^\"]*)\" ]]; then val="${BASH_REMATCH[1]}"
        elif [[ "$val" =~ ^\'([^\']*)\' ]]; then val="${BASH_REMATCH[1]}"
        else
            val="${val%%[[:space:]]#*}"
            val="${val%"${val##*[![:space:]]}"}"
        fi
        # shellcheck disable=SC2088  # literal "~/" prefix match is intended
        case "$val" in "~/"*) val="$HOME/${val#\~/}" ;; esac
        case "$allowed" in
            *" $key "*) printf -v "$key" '%s' "$val" ;;
            *) warn "$(basename "$file"): key $key is not used here — ignored" ;;
        esac
    done < "$file"
}

# reset_env_conf — the clean slate every env conf load starts from. Without it, a command that
# loads two confs in one process (clone-from-prod) inherits every key the second one omits —
# host, root, URL, port — and the checks after the load see the wrong values as valid.
reset_env_conf() {
    local v
    local IFS=' '
    for v in $ENV_KEYS $DERIVED_VARS; do unset "$v"; done
}

default_key() { printf '%s/.ssh/%s_%s_ed25519' "$HOME" "$PROJECT_SLUG" "$1"; }

# read_env_conf <env> — clean slate, parse, derive. Pure with respect to the network; the
# filesystem checks on the key happen in validate_env, so selftest can exercise this offline.
read_env_conf() {
    reset_env_conf
    case "${1:-}" in
        staging|production) ENV_NAME="$1" ;;
        '') die "missing environment: bin/deploy <staging|production> <command>" ;;
        *)  die "unknown environment '$1' (staging | production)" ;;
    esac
    CONF="$CONF_DIR/$ENV_NAME.conf"
    check_conf_file "$CONF"
    parse_conf "$CONF" "$ENV_KEYS"
    TRANSPORT="${DEPLOY_TRANSPORT:-ssh}"; HOST="${DEPLOY_HOST:-}"; PORT="${DEPLOY_PORT:-22}"
    RUSER="${DEPLOY_USER:-}"; RROOT="${DEPLOY_ROOT:-}"; URL="${DEPLOY_URL:-}"
    URL="${URL%/}"
    KEY="${DEPLOY_KEY:-$(default_key "$ENV_NAME")}"
}

validate_env() {
    local k
    for k in DEPLOY_HOST DEPLOY_USER DEPLOY_ROOT DEPLOY_URL; do
        is_placeholder "${!k:-}" && die "$k in $CONF is missing or still a placeholder (bin/deploy check-env)"
    done
    case "$HOST"  in *[!A-Za-z0-9._-]*) die "DEPLOY_HOST in $CONF contains invalid characters" ;; esac
    case "$RUSER" in *[!A-Za-z0-9._-]*) die "DEPLOY_USER in $CONF contains invalid characters" ;; esac
    case "$PORT"  in *[!0-9]*) die "DEPLOY_PORT in $CONF must be numeric" ;; esac
    [[ "$URL" == https://* ]] || die "DEPLOY_URL in $CONF must start with https://"
    RROOT="$(guard_path "$RROOT" .)" || die "DEPLOY_ROOT in $CONF is not a valid absolute path"
    [[ "$KEY" == default ]] && die "DEPLOY_KEY=default is no longer supported: run bin/deploy key-setup $ENV_NAME (dedicated key)"
    is_placeholder "$KEY" && die "DEPLOY_KEY in $CONF is still a placeholder"
    [[ -f "$KEY" ]] || die "SSH key $KEY not found — run: bin/deploy key-setup $ENV_NAME"
    case "$TRANSPORT" in
        ssh)  ;;
        sftp) command -v lftp >/dev/null || die "sftp transport needs lftp (brew install lftp)" ;;
        *) die "DEPLOY_TRANSPORT in $CONF must be ssh or sftp" ;;
    esac
}

select_env() {   # select_env <env> — the full, checked load
    check_conf_dir
    read_env_conf "${1:-}"
    validate_env
}

# local.conf is optional for push/doctor; commands that need LOCAL_URL call require_local_url.
load_local_conf() {
    local v IFS=' '
    for v in $LOCAL_KEYS; do unset "$v"; done
    [[ -f "$CONF_DIR/local.conf" ]] || return 0
    check_conf_file "$CONF_DIR/local.conf"
    parse_conf "$CONF_DIR/local.conf" "$LOCAL_KEYS"
}

# require_local_url — LOCAL_URL present, real and https, checked BEFORE any export or search-replace:
# an http:// LOCAL_URL rewrites every internal link in the wrong scheme, and a search-replace for
# http:// in a database that says https:// silently leaves the local domain behind on the server.
require_local_url() {
    is_placeholder "${LOCAL_URL:-}" && die "LOCAL_URL missing or still a placeholder in $CONF_DIR/local.conf"
    [[ "$LOCAL_URL" == https://* ]] || die "LOCAL_URL in $CONF_DIR/local.conf must be https (got a non-https URL)"
    LOCAL_URL="${LOCAL_URL%/}"
}

envvar() { case "$1" in URL) printf '%s' "$URL" ;; *) local n="DEPLOY_$1"; printf '%s' "${!n:-}" ;; esac; }

check_env() {
    local env k bad=0
    check_conf_dir
    for env in staging production; do
        if [[ ! -f "$CONF_DIR/$env.conf" ]]; then echo "  ✗ $env.conf missing (bin/deploy init)"; bad=1; continue; fi
        local out
        out="$( ( read_env_conf "$env"
                  for k in DEPLOY_HOST DEPLOY_USER DEPLOY_ROOT DEPLOY_URL; do
                      is_placeholder "${!k:-}" && echo "  ✗ $env.conf: $k"
                  done
                  [[ -f "$KEY" ]] || echo "  ✗ $env: SSH key not created yet (bin/deploy key-setup $env)"
                  true ) 2>&1 )" || true
        [[ -n "$out" ]] && { printf '%s\n' "$out"; bad=1; }
    done
    load_local_conf
    is_placeholder "${LOCAL_URL:-}" && { echo "  ✗ local.conf: LOCAL_URL"; bad=1; }
    [[ "$PROJECT_SLUG" == example-project ]] && { echo "  ✗ bin/deploy: PROJECT_SLUG is still example-project"; bad=1; }
    if [[ $bad -eq 0 ]]; then echo "check-env: staging, production and local fully configured"
    else echo "check-env: fill the keys above by hand in $CONF_DIR (values are never printed)"; fi
    return 0
}

log() {
    mkdir -p "$CONF_DIR"
    printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$ENV_NAME" \
        "$(git rev-parse --short HEAD 2>/dev/null || echo no-git)" "${USER:-?}" "$*" >> "$LOG_FILE"
}

SSH_OPTS=()
# Key-only authentication: never prompt for a password, fail fast if no key is accepted.
ssh_auth_opts() {
    SSH_OPTS=(-o BatchMode=yes -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no
              -o PreferredAuthentications=publickey -o ConnectTimeout=15)
    SSH_OPTS+=(-i "$KEY" -o IdentitiesOnly=yes)   # the dedicated key and nothing else
}
ssh_opts() { ssh_auth_opts; SSH_OPTS=(-p "$PORT" "${SSH_OPTS[@]}"); }
ssh_e()    { local IFS=' '; ssh_opts; printf 'ssh %s' "${SSH_OPTS[*]}"; }   # for rsync -e (IFS is \n\t globally)

remote_sh() {   # remote_sh <already-quoted command string>
    [[ "$TRANSPORT" == ssh ]] || die "this command needs the ssh transport"
    ssh_opts
    ssh "${SSH_OPTS[@]}" "$RUSER@$HOST" "$1"
}

remote_wp() {
    local q="" a
    for a in "$@"; do q+="$(printf '%q' "$a") "; done
    remote_sh "cd $(printf '%q' "$RROOT") && wp --path=$(printf '%q' "$RROOT") $q"
}

lftp_run() {    # lftp_run <lftp script> — sftp over ssh, same key-only authentication as above
    local o connect="ssh -a -x"
    ssh_auth_opts
    for o in "${SSH_OPTS[@]}"; do connect+=" $(printf '%q' "$o")"; done
    # "user," = empty password: lftp never asks for one; lftp adds -p/-l to the connect program itself.
    lftp -u "$RUSER," -p "$PORT" \
         -e "set sftp:auto-confirm yes; set net:max-retries 2; set sftp:connect-program \"$connect\"; $1; bye" \
         "sftp://$HOST"
}

# ---------------------------------------------------------------------------------------------
build_release() {
    info "Building theme assets ($THEME_DIR)"
    [[ -f "$THEME_DIR/package.json" ]] || die "$THEME_DIR/package.json not found — check THEME_DIR"
    ( cd "$THEME_DIR" && { [[ -d node_modules ]] || npm ci --no-audit --no-fund; } && npm run build )

    info "Assembling release in $BUILD_DIR/"
    # Synced in place with --delete, never rm -rf'd: a directory deleted and recreated at once can
    # look stale to a container (Docker Desktop file sharing on macOS) running LOCAL_COMPOSER_CMD.
    # vendor/ is excluded, so rsync keeps it and `composer install` reconciles it with the lock file.
    mkdir -p "$BUILD_DIR/theme" "$BUILD_DIR/mu-plugins"
    rsync -a --delete \
        --exclude node_modules --exclude vendor --exclude .git --exclude tests \
        --exclude '.env*' --exclude .DS_Store --exclude '*.log' \
        "$THEME_DIR/" "$BUILD_DIR/theme/"
    if [[ -f "$BUILD_DIR/theme/composer.json" ]]; then
        # LOCAL_COMPOSER_CMD runs composer where it lives: "composer" on the host, or e.g.
        # "docker exec -w <repo root in container> <php container> composer". The working dir is
        # passed RELATIVE to the repository root, so it resolves the same on host and in container.
        # Split on spaces only (the script's IFS is newline/tab); no quoting inside the value.
        # Unset and no host composer: derive it from LOCAL_WP_CMD when that is a container command
        # ending in "wp" (same container, same working dir) — "docker exec … php wp" → "… php composer".
        if [[ -z "${LOCAL_COMPOSER_CMD:-}" ]] && ! command -v composer >/dev/null \
            && [[ "${LOCAL_WP_CMD:-}" == *" wp" && "${LOCAL_WP_CMD:-}" != "wp" ]]; then
            LOCAL_COMPOSER_CMD="${LOCAL_WP_CMD% wp} composer"
            info "composer via LOCAL_WP_CMD's container: $LOCAL_COMPOSER_CMD"
        fi
        local -a composer_cmd
        IFS=' ' read -r -a composer_cmd <<< "${LOCAL_COMPOSER_CMD:-composer}"
        command -v "${composer_cmd[0]}" >/dev/null \
            || die "'${composer_cmd[0]}' not found — install composer or set LOCAL_COMPOSER_CMD in ~/.config/<slug>/local.conf"
        "${composer_cmd[@]}" install --no-dev --optimize-autoloader --no-interaction --no-progress \
            --working-dir="$BUILD_DIR/theme" >/dev/null \
            || die "composer install failed in $BUILD_DIR/theme (LOCAL_COMPOSER_CMD: ${LOCAL_COMPOSER_CMD:-composer})"
        [[ -f "$BUILD_DIR/theme/vendor/autoload.php" ]] || die "vendor/autoload.php missing after composer install"
    fi
    [[ -f "$BUILD_DIR/theme/public/build/manifest.json" ]] || die "Vite manifest missing after build"
    if [[ -d "$THEME_DIR/resources/js/blocks" ]]; then
        [[ -f "$BUILD_DIR/theme/public/blocks/index.asset.php" ]] || die "block bundle missing after build"
    fi
    [[ -d "$MU_PLUGINS_DIR" ]] && rsync -a --delete --exclude tests --exclude .DS_Store "$MU_PLUGINS_DIR/" "$BUILD_DIR/mu-plugins/"
    return 0
}

LAST_BACKUP=""

# backup_remote — snapshot everything a deploy can overwrite. Any failure stops the deploy.
# Unchanged files are hard-linked to the previous backup (rsync --link-dest), so keeping many
# backups costs little disk.
backup_remote() {
    local ts dir rel rpath p sha rels prev="" d
    for d in "$BACKUP_DIR/$ENV_NAME-"*; do [[ -f "$d/manifest" ]] && prev="$d"; done
    ts="$(date +%Y%m%d-%H%M%S)"; dir="$BACKUP_DIR/$ENV_NAME-$ts"
    local n=1
    while [[ -e "$dir" ]]; do n=$((n+1)); dir="$BACKUP_DIR/$ENV_NAME-$ts-$n"; done   # never reuse a backup dir
    mkdir -p "$dir/files"; chmod 700 "$CONF_DIR" "$BACKUP_DIR" "$dir"
    sha="$(git rev-parse --short HEAD 2>/dev/null || echo no-git)"
    {   echo "env $ENV_NAME"; echo "created $(date -u +%Y-%m-%dT%H:%M:%SZ)"; echo "before-commit $sha"
        echo "remote $TRANSPORT://$RUSER@$HOST$RROOT"; } > "$dir/manifest"

    rels=("$THEME_DIR" "$MU_PLUGINS_DIR")
    for rel in "${rels[@]}"; do
        rpath="$(guard_path "$RROOT" "$rel")" || die "backup: path fails validation: $rel"
        if remote_dir_exists "$rpath"; then
            info "Backup: $rel"
            mkdir -p "$dir/files/$rel"
            if [[ "$TRANSPORT" == ssh ]]; then
                local link=()
                [[ -n "$prev" && -d "$prev/files/$rel" ]] && link=(--link-dest="$prev/files/$rel")
                rsync -az "${link[@]+"${link[@]}"}" -e "$(ssh_e)" "$RUSER@$HOST:$rpath/" "$dir/files/$rel/" \
                    || die "backup of $rel failed — deploy NOT started"
            else
                lftp_run "mirror --parallel=4 $(printf '%q' "$rpath") $(printf '%q' "$dir/files/$rel")" \
                    || die "backup of $rel failed — deploy NOT started"
            fi
            echo "files $rel" >> "$dir/manifest"
        else
            echo "absent $rel" >> "$dir/manifest"
        fi
    done

    if [[ "$TRANSPORT" == ssh ]]; then
        info "Backup: database"
        remote_wp db export - | gzip -9 > "$dir/db.sql.gz" || die "database backup failed — deploy NOT started"
        [[ "$(gzip -cd "$dir/db.sql.gz" 2>/dev/null | head -c 64 | wc -c | tr -d ' ')" -gt 0 ]] \
            || die "database backup is empty ($dir/db.sql.gz) — deploy NOT started"
        echo "db db.sql.gz" >> "$dir/manifest"
    else
        warn "sftp transport: files backed up, database NOT (no remote wp-cli) — take a DB backup from the hosting panel if this release touches data"
        echo "nodb" >> "$dir/manifest"
    fi

    LAST_BACKUP="$(basename "$dir")"
    prune_backups
    info "Backup ready: $LAST_BACKUP — rollback: bin/deploy $ENV_NAME restore $LAST_BACKUP --confirm-restore=$PROJECT_SLUG"
}

prune_backups() {   # keep the newest BACKUP_KEEP backups for this environment (default 10)
    local keep="${BACKUP_KEEP:-10}" all=() d n i
    case "$keep" in ''|*[!0-9]*) keep=10 ;; esac
    [[ "$keep" -ge 1 ]] || keep=1
    for d in "$BACKUP_DIR/$ENV_NAME-"*; do [[ -d "$d" ]] && all+=("$d"); done
    n=${#all[@]}
    for (( i = 0; i < n - keep; i++ )); do rm -rf "${all[$i]}"; done
    return 0
}

list_backups() {
    local d found=""
    for d in "$BACKUP_DIR/$ENV_NAME-"*; do
        [[ -f "$d/manifest" ]] || continue
        found=1
        printf '%s  %s  commit-before %s  %s\n' "$(basename "$d")" \
            "$(sed -n 's/^created //p' "$d/manifest")" "$(sed -n 's/^before-commit //p' "$d/manifest")" \
            "$(awk '$1=="files"{f=f" "$2} $1=="db"{db=" +db"} END{print "files:" f db}' "$d/manifest")"
    done
    [[ -n "$found" ]] || echo "no backups for $ENV_NAME in $BACKUP_DIR/"
    return 0
}

restore() {
    local id="${1:-}" files=1 db=1 dry="" confirm="" confirm_prod="" a dir rel
    [[ -n "$id" ]] || die "usage: bin/deploy <env> restore <id|latest> --confirm-restore=$PROJECT_SLUG"
    shift
    for a in "$@"; do
        case "$a" in
            --files-only)            db="" ;;
            --db-only)               files="" ;;
            -n|--dry-run)            dry=1 ;;
            --confirm-restore=*)     confirm="${a#*=}" ;;
            --confirm-production=*)  confirm_prod="${a#*=}" ;;
            *) die "unknown option '$a'" ;;
        esac
    done
    if [[ "$id" == latest ]]; then
        for dir in "$BACKUP_DIR/$ENV_NAME-"*; do [[ -f "$dir/manifest" ]] && id="$(basename "$dir")"; done
        [[ "$id" != latest ]] || die "no backups for $ENV_NAME"
    fi
    case "$id" in "$ENV_NAME-"*) ;; *) die "backup '$id' does not belong to $ENV_NAME" ;; esac
    case "$id" in *[!A-Za-z0-9._-]*) die "invalid backup id" ;; esac
    dir="$BACKUP_DIR/$id"
    [[ -f "$dir/manifest" ]] || die "backup not found: $dir"

    info "RESTORE $id → $ENV_NAME ($(envvar URL))"
    if [[ -n "$files" ]]; then
        awk '$1=="files"{print "  files     "$2"  (exact copy: files added since are removed)"} $1=="absent"{print "  untouched "$2"  (did not exist before; left in place)"}' "$dir/manifest"
    fi
    if [[ -n "$db" ]]; then
        if grep -q '^db ' "$dir/manifest"; then echo "  database  replaced with the backup"; else warn "this backup has no database"; db=""; fi
    fi
    if [[ -z "$dry" ]]; then
        [[ "$confirm" == "$PROJECT_SLUG" ]] || die "restore requires the user's confirmation: --confirm-restore=$PROJECT_SLUG"
        if [[ "$ENV_NAME" == production ]]; then
            [[ "$confirm_prod" == "$PROJECT_SLUG" ]] || die "production restore also requires --confirm-production=$PROJECT_SLUG"
        fi
    fi

    if [[ -n "$files" ]]; then
        while IFS=" " read -r a rel; do   # IFS is \n\t globally: split on the space here
            [[ "$a" == files ]] || continue
            info "Restoring $rel"
            transfer "$dir/files/$rel" "$rel" 1 "$dry"
        done < "$dir/manifest"
    fi
    if [[ -n "$db" && -z "$dry" ]]; then
        [[ "$TRANSPORT" == ssh ]] || die "database restore needs the ssh transport — import $dir/db.sql.gz from the hosting panel"
        info "Restoring database"
        gzip -cd "$dir/db.sql.gz" | remote_wp db import -
    fi
    if [[ -z "$dry" && "$TRANSPORT" == ssh ]]; then
        remote_wp cache flush || true
        remote_wp rewrite flush || true
        remote_wp acorn optimize || warn "wp acorn optimize failed — run it manually"
    fi
    log "restore $id${dry:+ dry-run}"
    info "Restore done${dry:+ (dry run)}: $ENV_NAME — purge any page/CDN cache"
}

push() {
    local dry="" allow_dirty="" confirm="" a
    for a in "$@"; do
        case "$a" in
            -n|--dry-run)            dry=1 ;;
            --allow-dirty)           allow_dirty=1 ;;
            --confirm-production=*)  confirm="${a#*=}" ;;
            *) die "unknown option '$a'" ;;
        esac
    done

    if [[ "$ENV_NAME" == production && -z "$dry" ]]; then
        [[ "$confirm" == "$PROJECT_SLUG" ]] \
            || die "production push requires --confirm-production=$PROJECT_SLUG (explicit request only)"
        if [[ -z "$allow_dirty" && -n "$(git status --porcelain 2>/dev/null)" ]]; then
            die "working tree has uncommitted changes — commit them first or pass --allow-dirty"
        fi
    fi

    build_release

    local rtheme rmu
    rtheme="$(guard_path "$RROOT" "$THEME_DIR")"      || die "THEME_DIR fails path validation"
    rmu="$(guard_path "$RROOT" "$MU_PLUGINS_DIR")"    || die "MU_PLUGINS_DIR fails path validation"

    # Every real deploy starts from a backup of what it is about to overwrite.
    [[ -z "$dry" ]] && backup_remote

    info "Uploading to $ENV_NAME via $TRANSPORT${dry:+ (dry run)}"
    if [[ "$TRANSPORT" == ssh ]]; then
        ssh_opts
        local ropts=(-az --itemize-changes -e "$(ssh_e)")
        [[ -n "$dry" ]] && ropts+=(--dry-run)
        rsync "${ropts[@]}" --delete "$BUILD_DIR/theme/" "$RUSER@$HOST:$rtheme/"
        # mu-plugins: no --delete — hosts often install their own there.
        [[ -n "$(ls -A "$BUILD_DIR/mu-plugins")" ]] && rsync "${ropts[@]}" "$BUILD_DIR/mu-plugins/" "$RUSER@$HOST:$rmu/"
        if [[ -z "$dry" ]]; then
            info "Refreshing Acorn caches"
            remote_wp acorn optimize || warn "wp acorn optimize failed — run it manually"
        fi
    else
        local d=""; [[ -n "$dry" ]] && d="--dry-run"
        lftp_run "mirror --reverse --delete --verbose --parallel=4 $d $(printf '%q' "$BUILD_DIR/theme") $(printf '%q' "$rtheme")"
        [[ -n "$(ls -A "$BUILD_DIR/mu-plugins")" ]] && \
            lftp_run "mirror --reverse --verbose $d $(printf '%q' "$BUILD_DIR/mu-plugins") $(printf '%q' "$rmu")"
        [[ -z "$dry" ]] && warn "sftp transport: run 'wp acorn optimize' and purge the page cache from the hosting panel"
    fi

    log "push${dry:+ dry-run}"
    info "Done: $ENV_NAME ${dry:+(dry run) }— $(envvar URL)"
}

remote_dir_exists() {   # remote_dir_exists <absolute remote path>
    if [[ "$TRANSPORT" == ssh ]]; then
        remote_sh "test -d $(printf '%q' "$1")" 2>/dev/null
    else
        lftp_run "cls -d $(printf '%q' "$1")" >/dev/null 2>&1
    fi
}

transfer() {   # transfer <local dir> <repo-relative remote dir> <delete:0|1> <dry:""|1>
    local src="$1" rel="$2" del="$3" dry="$4" dst
    dst="$(guard_path "$RROOT" "$rel")" || die "remote path fails validation: $rel"
    [[ -d "$src" ]] || die "local directory not found: $src"
    if [[ "$TRANSPORT" == ssh ]]; then
        local ropts=(-az --itemize-changes --exclude .git --exclude .DS_Store -e "$(ssh_e)")
        [[ -n "$dry" ]] && ropts+=(--dry-run)
        [[ "$del" == 1 ]] && ropts+=(--delete)
        rsync "${ropts[@]}" "$src/" "$RUSER@$HOST:$dst/"
    else
        local d="" x=""
        [[ -n "$dry" ]] && d="--dry-run"
        [[ "$del" == 1 ]] && x="--delete"
        lftp_run "mirror --reverse $x --verbose --parallel=4 --exclude-glob .git/ --exclude-glob .DS_Store $d $(printf '%q' "$src") $(printf '%q' "$dst")"
    fi
}

# Run a LOCAL wp-cli PHP script (seed, migration) on the server. The script's directory is uploaded
# — .php files only — into a throwaway folder under wp-content/, run with `wp eval-file`, and
# removed again even if the script fails. Each script must start with defined('ABSPATH') || exit,
# so nothing in the folder does anything if requested over HTTP during those seconds.
eval_file() {   # eval_file <repo-relative .php file> [script args…]
    [[ "$TRANSPORT" == ssh ]] || die "eval-file needs the ssh transport (remote wp-cli)"
    local file="${1:-}"; shift || true
    [[ -f "$file" && "$file" == *.php ]] || die "usage: bin/deploy <env> eval-file <file.php> [args…]"
    local sdir base
    sdir="$(cd "$(dirname "$file")" && pwd)"; base="$(basename "$file")"
    case "$sdir/" in "$ROOT_DIR"/*) ;; *) die "eval-file: the script must live inside this repository" ;; esac
    local f
    while IFS= read -r f; do
        grep -q "defined('ABSPATH')" "$f" || die "eval-file: $f lacks defined('ABSPATH') || exit — it would be uploaded unguarded"
    done < <(find "$sdir" -name '*.php' -type f)
    local rel rdir
    rel="wp-content/.deploy-run-$(date +%Y%m%d%H%M%S)-$$"
    rdir="$(guard_path "$RROOT" "$rel")" || die "remote path fails validation: $rel"
    backup_remote   # a script that changes data is a deploy: snapshot first
    info "Uploading $(basename "$sdir")/*.php to $rel (temporary)"
    ssh_opts
    rsync -az --include '*/' --include '*.php' --exclude '*' -e "$(ssh_e)" "$sdir/" "$RUSER@$HOST:$rdir/" \
        || die "upload of $sdir failed"
    local rc=0
    remote_wp eval-file "$rdir/$base" "$@" || rc=$?
    remote_sh "rm -rf $(printf '%q' "$rdir")" || warn "could not remove $rdir on the server — delete it by hand"
    log "eval-file $file rc=$rc"
    [[ $rc -eq 0 ]] || die "remote eval-file $file failed (exit $rc)"
}

read_plugin_list() {   # prints one plugin slug per line from deploy-plugins.txt
    [[ -f deploy-plugins.txt ]] || return 0
    local line
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"; line="${line//[[:space:]]/}"
        [[ -z "$line" ]] && continue
        case "$line" in *[!a-z0-9_-]*) die "deploy-plugins.txt: invalid plugin slug '$line'" ;; esac
        printf '%s\n' "$line"
    done < deploy-plugins.txt
}

local_wp() {   # local_wp <args…> — runs LOCAL_WP_CMD (e.g. "wp", "ddev wp") from the repo root
    local IFS=' ' base
    read -r -a base <<< "${LOCAL_WP_CMD:-wp}"
    "${base[@]}" "$@"
}

bootstrap() {
    local plan="" dry="" with_db="" no_uploads="" no_plugins="" confirm="" confirm_prod="" a
    for a in "$@"; do
        case "$a" in
            --plan)                  plan=1 ;;
            -n|--dry-run)            dry=1 ;;
            --with-db)               with_db=1 ;;
            --no-uploads)            no_uploads=1 ;;
            --no-plugins)            no_plugins=1 ;;
            --confirm-bootstrap=*)   confirm="${a#*=}" ;;
            --confirm-production=*)  confirm_prod="${a#*=}" ;;
            *) die "unknown option '$a'" ;;
        esac
    done

    local plugins=() skipped=() p theme_slug local_url remote_url uploads="wp-content/uploads"
    if [[ -z "$no_plugins" ]]; then
        while IFS= read -r p; do [[ -n "$p" ]] && plugins+=("$p"); done < <(read_plugin_list)
        for p in "${plugins[@]+"${plugins[@]}"}"; do
            [[ -d "wp-content/plugins/$p" ]] || die "plugin '$p' listed in deploy-plugins.txt is not in wp-content/plugins/"
        done
    fi
    theme_slug="$(basename "$THEME_DIR")"
    # No trailing slash on either side: siteurl/home have none, and a mismatch would turn
    # https://local.test/page into https://staging.example.com//page during search-replace.
    remote_url="$URL"; local_url=""
    if [[ -n "$with_db" ]]; then
        [[ "$ENV_NAME" != production ]] || die "bootstrap --with-db does not exist for production: the production database is never overwritten"
        [[ "$TRANSPORT" == ssh ]] || die "--with-db needs the ssh transport (remote wp-cli); over sftp import the DB from the hosting panel"
        require_local_url; local_url="$LOCAL_URL"
    fi
    # Plugins already on the server are NEVER overwritten: they are updated from each environment's
    # admin, so the local copy is usually older — pushing it would silently downgrade them.
    if [[ ${#plugins[@]} -gt 0 ]]; then
        local missing=()
        for p in "${plugins[@]}"; do
            if remote_dir_exists "$(guard_path "$RROOT" "wp-content/plugins/$p")"; then skipped+=("$p"); else missing+=("$p"); fi
        done
        plugins=("${missing[@]+"${missing[@]}"}")
    fi

    # ---- the plan: always printed, and the only output of --plan ------------------------------
    info "FIRST DEPLOY (bootstrap) → $ENV_NAME  ($remote_url, $TRANSPORT://$RUSER@$HOST$RROOT)"
    printf '  %-12s %s\n' "theme"      "$THEME_DIR  (built: npm run build + composer --no-dev)  $(du -sh "$THEME_DIR" 2>/dev/null | cut -f1)"
    printf '  %-12s %s\n' "mu-plugins" "$MU_PLUGINS_DIR  $(du -sh "$MU_PLUGINS_DIR" 2>/dev/null | cut -f1)"
    if [[ -n "$no_plugins" ]]; then printf '  %-12s %s\n' "plugins" "skipped (--no-plugins)"
    elif [[ ${#plugins[@]} -eq 0 ]]; then printf '  %-12s %s\n' "plugins" "none (deploy-plugins.txt empty or missing)"
    else for p in "${plugins[@]}"; do printf '  %-12s %s\n' "plugin" "wp-content/plugins/$p  $(du -sh "wp-content/plugins/$p" | cut -f1)"; done; fi
    for p in "${skipped[@]+"${skipped[@]}"}"; do printf '  %-12s %s\n' "plugin" "$p — already on the server: left alone (never overwritten)"; done
    if [[ -n "$no_uploads" ]]; then printf '  %-12s %s\n' "uploads" "skipped (--no-uploads)"
    elif [[ -d "$uploads" ]]; then printf '  %-12s %s\n' "uploads" "$uploads  $(du -sh "$uploads" | cut -f1)  (added/updated, never deleted remotely)"
    else printf '  %-12s %s\n' "uploads" "none locally"; fi
    if [[ -n "$with_db" ]]; then
        printf '  %-12s %s\n' "database" "local DB REPLACES the remote DB (remote backup first); $local_url → $remote_url"
        printf '  %-12s %s\n' "" "remote users become the local ones; staging is set to discourage search engines"
    else printf '  %-12s %s\n' "database" "not transferred (add --with-db)"; fi
    if remote_dir_exists "$(guard_path "$RROOT" "$THEME_DIR")"; then
        warn "the theme already exists on $ENV_NAME — this is not a first deploy; 'push' is usually what you want"
    fi
    if [[ -n "$plan" ]]; then
        echo; echo "Plan only. Ask the user to confirm, then run with --confirm-bootstrap=$PROJECT_SLUG"
        return 0
    fi

    # ---- gates --------------------------------------------------------------------------------
    if [[ -z "$dry" ]]; then
        [[ "$confirm" == "$PROJECT_SLUG" ]] \
            || die "bootstrap requires the user's confirmation: show 'bootstrap --plan', then pass --confirm-bootstrap=$PROJECT_SLUG"
    fi
    if [[ -n "$with_db" ]]; then   # checked before anything is transferred, not at step 5
        local lprefix rprefix
        lprefix="$(local_wp config get table_prefix 2>/dev/null | tail -1)"
        rprefix="$(remote_wp config get table_prefix 2>/dev/null | tail -1)"
        [[ -n "$lprefix" && "$lprefix" == "$rprefix" ]] \
            || die "table prefix differs (local '$lprefix', remote '$rprefix') — align \$table_prefix in the remote wp-config.php first"
    fi
    local push_args=()
    [[ -n "$dry" ]] && push_args+=(--dry-run)
    [[ -n "$confirm_prod" ]] && push_args+=("--confirm-production=$confirm_prod")
    if [[ "$ENV_NAME" == production && -z "$dry" ]]; then
        [[ "$confirm_prod" == "$PROJECT_SLUG" ]] || die "production bootstrap also requires --confirm-production=$PROJECT_SLUG"
    fi

    # ---- 1. backup: push (step 2) snapshots theme, mu-plugins and the DB before writing ---------

    # ---- 2. theme + mu-plugins (build included) -------------------------------------------------
    push "${push_args[@]+"${push_args[@]}"}"

    # ---- 3. plugins -----------------------------------------------------------------------------
    for p in "${plugins[@]+"${plugins[@]}"}"; do
        info "Plugin: $p"
        transfer "wp-content/plugins/$p" "wp-content/plugins/$p" 0 "$dry"
    done

    # ---- 4. uploads -----------------------------------------------------------------------------
    if [[ -z "$no_uploads" && -d "$uploads" ]]; then
        info "Uploads"
        transfer "$uploads" "$uploads" 0 "$dry"
    fi

    # ---- 5. database ----------------------------------------------------------------------------
    if [[ -n "$with_db" && -z "$dry" ]]; then
        local dump="$BUILD_DIR/db.sql" safe esc_l esc_r
        info "Exporting local database"
        # Export to a FILE (written by mysqldump), never to stdout: a containerised wp-cli can print
        # PHP notices/deprecations on stdout, which would end up inside the dump. The path is
        # repo-relative, so it resolves the same for a host wp and a `docker exec -w <repo root>` wp.
        rm -f "$dump"
        local_wp db export "$dump" >/dev/null 2>&1 || die "local database export failed ($LOCAL_WP_CMD db export)"
        [[ -s "$dump" ]] || die "local database export is empty"
        head -c 4096 "$dump" | grep -q -e '^-- MariaDB dump' -e '^-- MySQL dump' -e '^/\*' \
            || die "local database export does not look like a SQL dump — check $dump"
        grep -q -i -e '^Deprecated:' -e '^Warning:' -e '^Notice:' -e '^PHP ' "$dump" \
            && die "local database export contains PHP messages — not importing it"
        # Out of the repository at once: a dump holds personal data and password hashes.
        mkdir -p "$DUMP_DIR"; chmod 700 "$DUMP_DIR"
        safe="$DUMP_DIR/local-$(date +%Y%m%d-%H%M%S).sql"
        ( umask 077; mv "$dump" "$safe" ); chmod 600 "$safe"; dump="$safe"
        info "Importing into $ENV_NAME"
        remote_wp db import - < "$dump"
        info "Replacing $local_url → $remote_url"
        remote_wp search-replace "$local_url" "$remote_url" --all-tables-with-prefix --skip-columns=guid --precise --report-changed-only
        esc_l="${local_url//\//\\\/}"; esc_r="${remote_url//\//\\\/}"      # JSON-escaped form used in block attributes
        remote_wp search-replace "$esc_l" "$esc_r" --all-tables-with-prefix --skip-columns=guid --precise --report-changed-only
        rm -f "$dump"
    fi

    # ---- 6. activate and refresh (ssh) ----------------------------------------------------------
    if [[ -z "$dry" ]]; then
        if [[ "$TRANSPORT" == ssh ]]; then
            remote_wp theme activate "$theme_slug"
            [[ ${#plugins[@]} -gt 0 ]] && remote_wp plugin activate "${plugins[@]}"
            [[ "$ENV_NAME" == staging ]] && remote_wp option update blog_public 0
            remote_wp rewrite flush || true
            remote_wp acorn optimize || warn "wp acorn optimize failed — run it manually"
        else
            warn "sftp transport: activate the theme '$theme_slug' and the plugins from wp-admin; on staging tick 'Discourage search engines'"
        fi
    fi

    log "bootstrap${dry:+ dry-run} plugins=${#plugins[@]} uploads=$([[ -z "$no_uploads" ]] && echo yes || echo no) db=$([[ -n "$with_db" ]] && echo yes || echo no)"
    info "Bootstrap done: $ENV_NAME ${dry:+(dry run) }— $remote_url"
}

doctor() {
    info "$ENV_NAME: $TRANSPORT://$RUSER@$HOST:$PORT$RROOT (key: $KEY)"
    ssh_opts
    if [[ "$TRANSPORT" == sftp ]]; then
        : # sftp-only hosts often refuse a shell command: the lftp listing below tests the key instead
    elif ssh "${SSH_OPTS[@]}" "$RUSER@$HOST" true 2>/dev/null; then
        echo "  ssh key authentication: ok"
    else
        die "ssh key authentication failed — add the public key on the server (bin/deploy key-setup $ENV_NAME prints it) or, for a passphrase key, ssh-add --apple-use-keychain $KEY"
    fi
    if [[ "$TRANSPORT" == ssh ]]; then
        remote_sh "test -f $(printf '%q' "$RROOT/wp-config.php")" && echo "  wp-config.php: found" || die "wp-config.php not found under ROOT"
        remote_wp core version >/dev/null && echo "  wp-cli: ok" || die "wp-cli not available remotely"
        remote_wp db check >/dev/null && echo "  database: ok" || die "database check failed"
    else
        lftp_run "cls -1 $(printf '%q' "$RROOT/wp-config.php")" >/dev/null && echo "  sftp key authentication + wp-config.php: ok" \
            || die "sftp failed — key not accepted (bin/deploy key-setup $ENV_NAME prints the public key) or wp-config.php not under DEPLOY_ROOT"
        echo "  wp-cli / database: not checkable over sftp"
    fi
}

# ---------------------------------------------------------------------------------------------
# Commands without an environment.

init_conf() {
    local f
    mkdir -p "$CONF_DIR" "$BACKUP_DIR" "$DUMP_DIR"
    chmod 700 "$CONF_DIR" "$BACKUP_DIR" "$DUMP_DIR"
    for f in staging production; do
        if [[ -f "$CONF_DIR/$f.conf" ]]; then echo "  kept     $CONF_DIR/$f.conf"
        else
            [[ -f bin/deploy.conf.example ]] || die "bin/deploy.conf.example missing in the repository"
            ( umask 077; cp bin/deploy.conf.example "$CONF_DIR/$f.conf" ); chmod 600 "$CONF_DIR/$f.conf"
            echo "  created  $CONF_DIR/$f.conf"
        fi
    done
    if [[ -f "$CONF_DIR/local.conf" ]]; then echo "  kept     $CONF_DIR/local.conf"
    else
        [[ -f bin/deploy.local.conf.example ]] || die "bin/deploy.local.conf.example missing in the repository"
        ( umask 077; cp bin/deploy.local.conf.example "$CONF_DIR/local.conf" ); chmod 600 "$CONF_DIR/local.conf"
        echo "  created  $CONF_DIR/local.conf"
    fi
    echo "init: fill the values by hand (never paste them into a chat), then: bin/deploy check-env"
}

key_setup() {
    local env="${1:-}" pass="" key
    case "$env" in staging|production) ;; *) die "usage: bin/deploy key-setup <staging|production> [--passphrase]" ;; esac
    [[ "${2:-}" == --passphrase ]] && pass=1
    key="$(default_key "$env")"
    if [[ -f "$CONF_DIR/$env.conf" ]]; then read_env_conf "$env"; [[ "$KEY" != default ]] && ! is_placeholder "$KEY" && key="$KEY"; fi
    mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
    if [[ -f "$key" ]]; then
        echo "key already present: $key"
    elif [[ -n "$pass" ]]; then
        # Interactive: run it in your own terminal. Then add the key to the agent/Keychain so
        # BatchMode can use it: ssh-add --apple-use-keychain "$key"
        ssh-keygen -t ed25519 -a 100 -f "$key" -C "$PROJECT_SLUG-$env-deploy"
        echo "now: ssh-add --apple-use-keychain $key"
    else
        ssh-keygen -q -t ed25519 -a 100 -N "" -f "$key" -C "$PROJECT_SLUG-$env-deploy"
    fi
    chmod 600 "$key"
    printf '\nPublic key to add on the %s server (hosting panel → SSH keys, or ~/.ssh/authorized_keys):\n\n' "$env"
    cat "$key.pub"
}

# migrate_env — move a legacy repo-root .env into the per-environment confs. Never prints a value:
# only key names. Refuses to overwrite existing confs. Deleting .env needs --delete-env, which an
# agent passes only after the user said yes in the conversation.
migrate_env() {
    local delete="" line key val dest dk
    [[ "${1:-}" == --delete-env ]] && delete=1
    [[ -f .env ]] || die "no .env at the repository root — nothing to migrate"
    mkdir -p "$CONF_DIR"; chmod 700 "$CONF_DIR"

    if [[ -z "$delete" ]]; then
        local f
        for f in staging production local; do
            [[ -e "$CONF_DIR/$f.conf" ]] && die "$CONF_DIR/$f.conf already exists — move it away first (nothing was written)"
        done
        ( umask 077; : > "$CONF_DIR/staging.conf"; : > "$CONF_DIR/production.conf"; : > "$CONF_DIR/local.conf" )
        chmod 600 "$CONF_DIR/staging.conf" "$CONF_DIR/production.conf" "$CONF_DIR/local.conf"
        for f in staging production local; do
            echo "# migrated from .env by bin/deploy migrate-env on $(date -u +%Y-%m-%d)" >> "$CONF_DIR/$f.conf"
        done
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
            [[ "$line" =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]] || continue
            key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
            val="${val%%[[:space:]]#*}"; val="${val%"${val##*[![:space:]]}"}"
            dest=""; dk=""
            case "$key" in
                STAGING_*|PRODUCTION_*)
                    dest="$(printf '%s' "${key%%_*}" | tr 'A-Z' 'a-z')"; dk="${key#*_}"
                    case "$dk" in
                        SSH_KEY) dk=DEPLOY_KEY
                                 [[ "$val" == default || -z "$val" ]] && { echo "  dropped  $key (default keys → run bin/deploy key-setup $dest)"; continue; } ;;
                        URL|TRANSPORT|HOST|PORT|USER|ROOT) dk="DEPLOY_$dk" ;;
                        SFTP_PASSWORD) echo "  dropped  $key (passwords are not supported: SSH key only)"; continue ;;
                        *) echo "  dropped  $key (unknown)"; continue ;;
                    esac ;;
                LOCAL_URL|LOCAL_WP_CMD|LOCAL_COMPOSER_CMD|BACKUP_KEEP) dest=local; dk="$key" ;;
                LOCAL_DB_*) echo "  dropped  $key (read from the local wp-config.php)"; continue ;;
                PROJECT_SLUG) [[ "$val" == "$PROJECT_SLUG" ]] || echo "  check    PROJECT_SLUG differs from bin/deploy — set it at the top of bin/deploy"; continue ;;
                THEME_DIR) [[ "$val" == "$THEME_DIR" ]] || echo "  check    THEME_DIR differs from wp-content/themes/\$THEME_SLUG — set THEME_SLUG in bin/deploy"; continue ;;
                MU_PLUGINS_DIR|LOCAL_WP_PATH) echo "  dropped  $key (fixed or unused)"; continue ;;
                *) echo "  dropped  $key (unknown)"; continue ;;
            esac
            printf '%s=%s\n' "$dk" "$val" >> "$CONF_DIR/$dest.conf"
            echo "  moved    $key → $dest.conf:$dk"
        done < .env
        chmod 600 "$CONF_DIR"/*.conf
        if git log --all --oneline -- .env 2>/dev/null | grep -q .; then
            warn ".env appears in git history — treat every secret it ever held as exposed and rotate it"
        fi
        echo
        echo "migrate-env: confs written to $CONF_DIR (700/600). Run: bin/deploy check-env"
        echo "Ask the user to confirm, then delete the old file with: bin/deploy migrate-env --delete-env"
        return 0
    fi

    # --delete-env: only once the three confs exist with the right permissions.
    check_conf_dir
    local f
    for f in staging production local; do check_conf_file "$CONF_DIR/$f.conf"; done
    rm -f .env || die "could not delete .env"
    [[ ! -e .env ]] || die ".env still present"
    echo "migrate-env: .env deleted. Config now lives only in $CONF_DIR"
}

# clone_from_prod — staging := copy of the production database. The direction is fixed by the name
# and the code: there is no reverse. Refuses when the two confs point at the same URL or root.
clone_from_prod() {
    local confirm="" a prod_url prod_host prod_root prod_dump esc_p esc_s
    for a in "$@"; do
        case "$a" in --confirm-clone=*) confirm="${a#*=}" ;; *) die "unknown option '$a'" ;; esac
    done
    [[ "$confirm" == "$PROJECT_SLUG" ]] \
        || die "clone-from-prod overwrites the staging database: confirm with the user, then pass --confirm-clone=$PROJECT_SLUG"

    select_env production
    [[ "$TRANSPORT" == ssh ]] || die "clone-from-prod needs the ssh transport on production"
    prod_url="$URL"; prod_host="$HOST"; prod_root="$RROOT"
    mkdir -p "$DUMP_DIR"; chmod 700 "$DUMP_DIR"
    prod_dump="$DUMP_DIR/production-$(date +%Y%m%d-%H%M%S).sql.gz"
    info "1/5 export production database"
    remote_wp db export - | gzip -9 > "$prod_dump" || die "production export failed"
    [[ "$(gzip -cd "$prod_dump" | head -c 64 | wc -c | tr -d ' ')" -gt 0 ]] || die "production dump is empty"

    select_env staging                   # clean slate: nothing carried over from production.conf
    [[ "$TRANSPORT" == ssh ]] || die "clone-from-prod needs the ssh transport on staging"
    [[ "$URL" != "$prod_url" ]] || die "staging and production have the same DEPLOY_URL — check the two confs"
    [[ "$HOST:$RROOT" != "$prod_host:$prod_root" ]] || die "staging and production point at the same host and root"

    info "2/5 backup staging"
    backup_remote
    info "3/5 import into staging"
    gzip -cd "$prod_dump" | remote_wp db import -
    info "4/5 search-replace $prod_url → $URL"
    remote_wp search-replace "$prod_url" "$URL" --all-tables-with-prefix --skip-columns=guid --precise --report-changed-only
    esc_p="${prod_url//\//\\\/}"; esc_s="${URL//\//\\\/}"
    remote_wp search-replace "$esc_p" "$esc_s" --all-tables-with-prefix --skip-columns=guid --precise --report-changed-only
    info "5/5 flush and protect"
    remote_wp option update blog_public 0
    remote_wp cache flush || true
    remote_wp rewrite flush || true
    remote_wp acorn optimize || warn "wp acorn optimize failed — run it manually"
    log "clone-from-prod $(basename "$prod_dump")"
    info "staging is now a copy of production ($URL). Rollback: bin/deploy staging restore $LAST_BACKUP --confirm-restore=$PROJECT_SLUG"
}

# refuse_early <env> <cmd> <args…> — refusals that need no config and no network, checked before
# anything is loaded, so selftest can prove them offline.
refuse_early() {
    local env="$1" cmd="$2" a; shift 2
    if [[ "$env" == production && "$cmd" == bootstrap ]]; then
        for a in "$@"; do
            [[ "$a" == --with-db ]] && die "bootstrap --with-db does not exist for production: the production database is never overwritten"
        done
    fi
    if [[ "$env" == production && "$cmd" == restore ]]; then
        for a in "$@"; do
            [[ "$a" == --confirm-production=* ]] && return 0
        done
        [[ " $* " == *" --dry-run "* ]] || die "production restore requires --confirm-production=$PROJECT_SLUG too"
    fi
    return 0
}

# ---------------------------------------------------------------------------------------------
[[ $# -ge 1 ]] || { sed -n '3,33p' "$0"; exit 1; }
case "$1" in
    selftest)        selftest; exit 0 ;;
    -h|--help|help)  sed -n '3,48p' "$0"; exit 0 ;;
    init)            init_conf; exit 0 ;;
    key-setup)       shift; key_setup "$@"; exit 0 ;;
    clone-from-prod) shift
                     [[ " $* " == *" --confirm-clone=$PROJECT_SLUG "* ]] \
                         || die "clone-from-prod overwrites the staging database: confirm with the user, then pass --confirm-clone=$PROJECT_SLUG"
                     [[ "$PROJECT_SLUG" != example-project ]] || die "set PROJECT_SLUG at the top of bin/deploy first"
                     load_local_conf; clone_from_prod "$@"; exit 0 ;;
    migrate-env)     shift; migrate_env "$@"; exit 0 ;;
    check-env)       check_env; exit 0 ;;
    doctor|push|bootstrap|wp|eval-file|backup|db-backup|backups|restore)
                     die "missing environment: bin/deploy <staging|production> $1 — there is no default" ;;
    staging|production) ;;
    *)               die "unknown environment '$1' (staging | production)" ;;
esac

env_arg="$1"; shift
cmd="${1:-}"; shift || true
[[ -n "$cmd" ]] || die "missing command: bin/deploy $env_arg <command> (bin/deploy help)"
refuse_early "$env_arg" "$cmd" "$@"
[[ "$PROJECT_SLUG" != example-project ]] || die "set PROJECT_SLUG at the top of bin/deploy first (it is still example-project)"
load_local_conf
select_env "$env_arg"
case "$cmd" in
    doctor)    doctor ;;
    push)      push "$@" ;;
    bootstrap) bootstrap "$@" ;;
    wp)        [[ $# -ge 1 ]] || die "usage: bin/deploy <env> wp <args…>"
               if [[ "$ENV_NAME" == production ]]; then
                   case "${1:-}" in
                       option|core|plugin|theme|user|post|search-replace|db|eval|eval-file|shell|config)
                           warn "production wp-cli: '$1' can change data — agents run this only on explicit request" ;;
                   esac
               fi
               remote_wp "$@"; log "wp $1" ;;
    eval-file) [[ "$ENV_NAME" == production ]] \
                   && warn "production eval-file changes data — agents run this only on explicit request"
               eval_file "$@" ;;
    backup|db-backup) backup_remote ;;
    backups)   list_backups ;;
    restore)   restore "$@" ;;
    *) die "unknown command '$cmd' (doctor | push | bootstrap | backup | backups | restore | wp | eval-file)" ;;
esac
